	"nodes":[
		{"id":"f250350dea0cf3c1","type":"text","text":"```json\n[\n  {\n    \"id\": \"T1_happypath_seed\",\n    \"input\": {\n      \"q1\": \"A web app that helps small restaurants manage online orders and delivery routing\",\n      \"q2\": \"Restaurants need a simple way to accept orders and optimize delivery routes so they can reduce delivery times and mistakes.\",\n      \"q3\": \"saas\",\n      \"q4\": \"technical founder\",\n      \"q5\": \"Actively building(im working on this seriously, may have early users)\",\n\t      \"q6\": \"Independent restaurant owners in suburban US towns who use delivery marketplaces but lack in-house tech\",\n      \"q7\": \"United States\"\n    },\n    \"normalized\": {\n      \"product\": \"web app for restaurant order & delivery routing\",\n      \"problem\": \"reduce delivery times and mistakes for independent restaurant owners using marketplaces\",\n      \"sector\": \"saas\",\n      \"technical_background\": \"technical\",\n      \"stage\": \"actively_building\",\n      \"first_user\": \"independent restaurant owners, suburban US\",\n      \"geography\": {\"country\":\"United States\",\"region\":null}\n    },\n    \"expected_checks\": [\"valid sector\",\"stage actionable\",\"no follow-ups\"]\n  },\n\n  {\n    \"id\": \"T2_minimal_inputs\",\n    \"input\": {\n      \"q1\": \"App for tutors\",\n      \"q2\": \"Helps tutors find students\",\n      \"q3\": \"edtech\",\n      \"q4\": \"non technical\",\n      \"q5\": \"Just an idea (I havent built, tested anything yet)\",\n      \"q6\": \"High-school tutors\",\n      \"q7\": \"India\"\n    },\n    \"normalized\": {\n      \"product\": \"app for tutors\",\n      \"problem\": \"help tutors find students\",\n      \"sector\": \"edtech\",\n      \"technical_background\": \"non_technical\",\n      \"stage\": \"idea\",\n      \"first_user\": \"high-school tutors\",\n      \"geography\": {\"country\":\"India\"}\n    },\n    \"expected_checks\": [\"flag: very short q2 -> ask for 2–3 user stories\",\"offer basic next steps for idea stage\"]\n  },\n\n  {\n    \"id\": \"T3_edge_long_text\",\n    \"input\": {\n      \"q1\": \"An AI-driven personalized skincare recommendation engine that ingests images, questionnaires, seasonal data, and purchase history to recommend routines and OTC products — with a premium tele-derm consult addon\",\n      \"q2\": \"Users are overwhelmed by conflicting skincare advice and product marketing; they want quick personalized routines that actually address their skin conditions and are safe to use with their medications.\",\n      \"q3\": \"healthtech\",\n      \"q4\": \"semi technical\",\n      \"q5\": \"Actively building(im working on this seriously, may have early users)\",\n\t   \"q6\": \"Women aged 25-45 in urban areas with acne/rosacea issues who buy online skincare\",\n      \"q7\": \"United Kingdom\"\n    },\n    \"normalized\": {\n      \"product\": \"ai-driven personalized skincare recommendation engine + tele-derm addon\",\n      \"problem\": \"users need trustworthy personalized skincare routines that are safe with meds\",\n      \"sector\": \"healthtech\",\n      \"technical_background\": \"semi_technical\",\n      \"stage\": \"actively_building\",\n      \"first_user\": \"women 25-45, urban, acne/rosacea\",\n      \"geography\": {\"country\":\"United Kingdom\"}\n    },\n    \"expected_checks\": [\"flag: healthtech -> regulatory warning (medical claims)\",\"ask about HIPAA/GDPR readiness\"]\n  },\n\n  {\n    \"id\": \"T4_nonstandard_sector_free_text\",\n    \"input\": {\n      \"q1\": \"B2B supply-chain visibility tool for cocoa bean traceability\",\n      \"q2\": \"Chocolate makers want to trace origin and certifications to meet buyer demands.\",\n      \"q3\": \"other: sustainability / traceability\",\n      \"q4\": \"technical founder\",\n      \"q5\": \"already launched(looking to grow or fixing my strategy)\",\n      \"q6\": \"Procurement leads at mid-size chocolate manufacturers in Europe\",\n      \"q7\": \"Netherlands\"\n    },\n    \"normalized\": {\n      \"product\": \"supply-chain visibility tool for cocoa traceability\",\n      \"problem\": \"help chocolate makers trace origin and certifications\",\n      \"sector\": \"other\",\n      \"sector_custom\": \"sustainability / traceability\",\n      \"technical_background\": \"technical\",\n      \"stage\": \"launched\",\n      \"first_user\": \"procurement leads, mid-size chocolate manufacturers, Europe\",\n      \"geography\": {\"country\":\"Netherlands\"}\n    },\n    \"expected_checks\": [\"accept sector_custom\",\"ensure enum other is allowed\"]\n  },\n\n  {\n    \"id\": \"T5_typo_inputs\",\n    \"input\": {\n\t  \"q1\": \"D2C brand for eco-friendly water botles\",\n\t  \"q2\": \"Consumers want durable reusable bottles that don't leak and are sustainable.\",\n      \"q3\": \"d2c or ecommerce\",\n      \"q4\": \"non technical\",\n      \"q5\": \"side project( tinkering nothing serious yet)\",\n      \"q6\": \"Millennial urban commuters who cycle to work\",\n      \"q7\": \"Canada\"\n    },\n    \"normalized\": {\n      \"product\": \"d2c eco-friendly water bottles\",\n      \"problem\": \"durable reusable no-leak sustainable bottles for commuters\",\n      \"sector\": \"d2c_ecommerce\",\n      \"technical_background\": \"non_technical\",\n      \"stage\": \"side_project\",\n      \"first_user\": \"millennial urban cyclists\",\n      \"geography\": {\"country\":\"Canada\"}\n    },\n    \"expected_checks\": [\"normalize 'botles'->'bottles' if spellcheck enabled\",\"map sector synonyms -> d2c_ecommerce\"]\n  },\n\n  {\n    \"id\": \"T6_non_english_input\",\n    \"input\": {\n      \"q1\": \"Aplicación para reservar clases de yoga\",\n      \"q2\": \"Personas ocupadas necesitan clases flexibles cerca de casa y sin suscripciones largas.\",\n      \"q3\": \"saas\",\n      \"q4\": \"non technical\",\n      \"q5\": \"Actively building(im working on this seriously, may have early users)\",\n      \"q6\": \"Millennials en ciudades pequeñas que buscan clases presenciales y on-demand\",\n      \"q7\": \"Spain\"\n    },\n    \"normalized\": {\n      \"product\": \"app for booking yoga classes\",\n      \"problem\": \"busy people need flexible local classes without long subscriptions\",\n      \"sector\": \"saas\",\n      \"technical_background\": \"non_technical\",\n      \"stage\": \"actively_building\",\n      \"first_user\": \"millennials in small cities seeking in-person & on-demand classes\",\n      \"geography\": {\"country\":\"Spain\"}\n    },\n    \"expected_checks\": [\"language detection-> offer translation to English for analysis\",\"store original locale text\"]\n  },\n\n  {\n    \"id\": \"T7_ambiguous_problem\",\n    \"input\": {\n      \"q1\": \"Marketplace for local photographers\",\n      \"q2\": \"We make photography better.\",\n      \"q3\": \"market place\",\n      \"q4\": \"semi technical\",\n      \"q5\": \"Actively building(im working on this seriously, may have early users)\",\n      \"q6\": \"Photographers and people who need event photos\",\n      \"q7\": \"Australia\"\n    },\n    \"normalized\": {\n      \"product\": \"marketplace for local photographers\",\n      \"problem\": \"vague: 'make photography better' (needs specificity)\",\n      \"sector\": \"marketplace\",\n      \"technical_background\": \"semi_technical\",\n      \"stage\": \"actively_building\",\n      \"first_user\": \"photographers + event photo customers\",\n      \"geography\": {\"country\":\"Australia\"}\n    },\n    \"expected_checks\": [\"flag: vague q2 -> request 2 concrete pain points & success metric\"]\n  },\n\n  {\n    \"id\": \"T8_global_remote\",\n    \"input\": {\n      \"q1\": \"Developer tool to lint and auto-format SQL across DB vendors\",\n      \"q2\": \"Developers waste time fixing SQL style & compatibility when switching databases.\",\n      \"q3\": \"dev tools\",\n      \"q4\": \"technical founder\",\n      \"q5\": \"already launched(looking to grow or fixing my strategy)\",\n      \"q6\": \"Backend engineers and data analysts at startups\",\n      \"q7\": \"global / remote\"\n    },\n    \"normalized\": {\n      \"product\": \"sql lint & auto-format tool\",\n      \"problem\": \"reduce time fixing SQL style and db-compatibility issues\",\n      \"sector\": \"devtools\",\n      \"technical_background\": \"technical\",\n      \"stage\": \"launched\",\n      \"first_user\": \"backend engineers & data analysts at startups\",\n      \"geography\": {\"country\":\"global\"}\n    },\n    \"expected_checks\": [\"accept 'global'\",\"no geography-specific advice needed\"]\n  },\n\n  {\n    \"id\": \"T9_conflicting_stage_signals\",\n    \"input\": {\n      \"q1\": \"SaaS dashboard for fleet EV charging analytics\",\n      \"q2\": \"Fleet ops need to know charging patterns and costs to optimize routes and charging schedules.\",\n      \"q3\": \"saas\",\n      \"q4\": \"semi technical\",\n      \"q5\": \"Just an idea (I havent built, tested anything yet)\",\n      \"q6\": \"Fleet operations managers at delivery companies\",\n      \"q7\": \"Germany\"\n    },\n    \"normalized\": {\n      \"product\": \"fleet EV charging analytics dashboard\",\n      \"problem\": \"optimize charging schedules, route costs\",\n      \"sector\": \"saas\",\n      \"technical_background\": \"semi_technical\",\n      \"stage\": \"idea\",\n      \"first_user\": \"fleet ops managers\",\n      \"geography\": {\"country\":\"Germany\"}\n    },\n    \"expected_checks\": [\"if q6 mentions enterprise users -> recommend enterprise sales guidance only when stage >= actively_building\"]\n  },\n\n  {\n    \"id\": \"T10_sensitive_persona_possible_gdpr\",\n    \"input\": {\n      \"q1\": \"Mental-health chatbot for college students\",\n      \"q2\": \"Students want quick support and signposting to campus resources without stigma.\",\n      \"q3\": \"healthtech\",\n      \"q4\": \"non technical\",\n      \"q5\": \"Actively building(im working on this seriously, may have early users)\",\n      \"q6\": \"University students aged 18-24 in EU universities\",\n      \"q7\": \"European Union\"\n    },\n    \"normalized\": {\n      \"product\": \"mental-health chatbot for college students\",\n      \"problem\": \"provide quick supportive signposting for students\",\n      \"sector\": \"healthtech\",\n      \"technical_background\": \"non_technical\",\n      \"stage\": \"actively_building\",\n      \"first_user\": \"university students 18-24, EU\",\n      \"geography\": {\"country\":\"EU\"}\n    },\n    \"expected_checks\": [\"privacy/regulatory flag (GDPR + sensitive health data)\",\"do not suggest unqualified medical advice\"]\n  },\n\n  {\n    \"id\": \"T11_empty_fields\",\n    \"input\": {\n      \"q1\": \"\",\n      \"q2\": \"\",\n      \"q3\": \"\",\n      \"q4\": \"\",\n      \"q5\": \"\",\n      \"q6\": \"\",\n      \"q7\": \"\"\n    },\n    \"normalized\": {\n      \"product\": null,\n      \"problem\": null,\n      \"sector\": null,\n      \"technical_background\": null,\n      \"stage\": null,\n      \"first_user\": null,\n      \"geography\": null\n    },\n    \"expected_checks\": [\"fail validation for required q1,q3,q4,q5,q7\",\"show inline errors\",\"provide examples in placeholders\"]\n  },\n\n  {\n    \"id\": \"T12_non_specific_geography_city\",\n    \"input\": {\n      \"q1\": \"Hyperlocal social network for neighborhood swap & sell\",\n      \"q2\": \"Neighbors want to give away items and find used goods nearby without paying platform fees.\",\n      \"q3\": \"market place\",\n      \"q4\": \"non technical\",\n      \"q5\": \"side project( tinkering nothing serious yet)\",\n      \"q6\": \"Residents in a very small town (population 8k)\",\n      \"q7\": \"Pune, India\"\n    },\n    \"normalized\": {\n      \"product\": \"hyperlocal neighborhood swap & sell\",\n      \"problem\": \"local giving/used goods without fees\",\n      \"sector\": \"marketplace\",\n      \"technical_background\": \"non_technical\",\n      \"stage\": \"side_project\",\n      \"first_user\": \"residents in small towns (pop ~8k)\",\n      \"geography\": {\"country\":\"India\",\"city\":\"Pune\"}\n    },\n    \"expected_checks\": [\"parse city+country\",\"offer localized onboarding tips\"]\n  }\n]\n```","x":-1615,"y":320,"width":960,"height":2180},
		{"id":"33169573b9e9b0ce","type":"text","text":"```json\n[\n  {\n    \"id\": \"T3_edge_long_text_1\",\n    \"input\": {\n      \"q1\": \"An AI-powered nutrition planner that analyzes blood test results, wearable data, and lifestyle questionnaires to generate weekly meal plans and supplement suggestions with optional dietitian consultations\",\n      \"q2\": \"People receive generic diet advice online but struggle to connect it with their actual blood markers, health conditions, and daily routines.\",\n      \"q3\": \"healthtech\",\n      \"q4\": \"semi technical\",\n      \"q5\": \"Actively building (early prototype with some beta testers)\",\n      \"q6\": \"Health-conscious adults aged 30-55 managing cholesterol, fatigue, or metabolic issues\",\n      \"q7\": \"United Kingdom\"\n    },\n    \"normalized\": {\n      \"product\": \"ai-powered personalized nutrition planner with dietitian consultation addon\",\n      \"problem\": \"users need diet guidance personalized to health data rather than generic nutrition advice\",\n      \"sector\": \"healthtech\",\n      \"technical_background\": \"semi_technical\",\n      \"stage\": \"actively_building\",\n      \"first_user\": \"adults 30-55 managing metabolic health\",\n      \"geography\": {\"country\": \"United Kingdom\"}\n    },\n    \"expected_checks\": [\n      \"flag: healthtech -> regulatory warning (medical claims)\",\n      \"ask about GDPR and medical data compliance\"\n    ]\n  },\n  {\n    \"id\": \"T3_edge_long_text_2\",\n    \"input\": {\n      \"q1\": \"A browser extension that uses AI to summarize complex financial news and explain how it affects personal investments in simple language\",\n\t      \"q2\": \"Retail investors feel overwhelmed by financial jargon and struggle to interpret how macro news impacts their portfolios.\",\n      \"q3\": \"fintech\",\n      \"q4\": \"non technical\",\n      \"q5\": \"Just exploring\",\n      \"q6\": \"Young professionals investing through trading apps\",\n      \"q7\": \"United States\"\n    },\n    \"normalized\": {\n      \"product\": \"ai-powered financial news simplification browser extension\",\n      \"problem\": \"retail investors struggle to interpret financial news and investment impact\",\n      \"sector\": \"fintech\",\n      \"technical_background\": \"non_technical\",\n      \"stage\": \"idea_stage\",\n      \"first_user\": \"young retail investors\",\n      \"geography\": {\"country\": \"United States\"}\n    },\n    \"expected_checks\": [\n      \"flag: fintech -> investment advice compliance\",\n      \"ask about SEC or financial advisory regulation risk\"\n    ]\n  },\n  {\n    \"id\": \"T3_edge_long_text_3\",\n    \"input\": {\n      \"q1\": \"An AI interview simulator that analyzes candidate responses, tone, and facial expressions during mock interviews to provide personalized coaching\",\n      \"q2\": \"Job seekers struggle to prepare for behavioral interviews and rarely receive detailed feedback on their answers.\",\n      \"q3\": \"edtech\",\n      \"q4\": \"semi technical\",\n      \"q5\": \"MVP built\",\n      \"q6\": \"Recent graduates preparing for corporate roles\",\n      \"q7\": \"Canada\"\n    },\n    \"normalized\": {\n      \"product\": \"ai interview coaching and simulation platform\",\n      \"problem\": \"job seekers lack realistic interview practice and feedback\",\n      \"sector\": \"edtech\",\n      \"technical_background\": \"semi_technical\",\n      \"stage\": \"mvp\",\n      \"first_user\": \"recent graduates entering workforce\",\n      \"geography\": {\"country\": \"Canada\"}\n    },\n    \"expected_checks\": [\n      \"check: biometric data usage\",\n      \"ask about consent and privacy policies\"\n    ]\n  },\n  {\n    \"id\": \"T3_edge_long_text_4\",\n    \"input\": {\n      \"q1\": \"A mobile app that uses AI to track household food inventory via receipt scanning and fridge photos to reduce food waste\",\n      \"q2\": \"Families often forget what food they have at home and end up wasting groceries.\",\n      \"q3\": \"consumer tech\",\n      \"q4\": \"non technical\",\n      \"q5\": \"Idea stage\",\n      \"q6\": \"Busy urban families trying to reduce food waste\",\n      \"q7\": \"Australia\"\n    },\n    \"normalized\": {\n      \"product\": \"ai household food inventory and waste reduction app\",\n      \"problem\": \"households waste groceries due to poor inventory awareness\",\n      \"sector\": \"consumer_tech\",\n      \"technical_background\": \"non_technical\",\n      \"stage\": \"idea_stage\",\n      \"first_user\": \"urban families\",\n      \"geography\": {\"country\": \"Australia\"}\n    },\n    \"expected_checks\": [\n      \"check: receipt data privacy\",\n      \"ask about retailer integration feasibility\"\n    ]\n  },\n  {\n    \"id\": \"T3_edge_long_text_5\",\n    \"input\": {\n      \"q1\": \"An AI legal document assistant that helps small businesses understand contracts by translating legal language into plain English and highlighting risky clauses\",\n      \"q2\": \"Small business owners sign contracts without fully understanding the legal implications.\",\n      \"q3\": \"legaltech\",\n      \"q4\": \"semi technical\",\n      \"q5\": \"Actively building\",\n      \"q6\": \"Freelancers and small agency owners\",\n      \"q7\": \"United Kingdom\"\n    },\n    \"normalized\": {\n      \"product\": \"ai legal contract simplification assistant\",\n      \"problem\": \"small businesses struggle to interpret complex legal contracts\",\n      \"sector\": \"legaltech\",\n      \"technical_background\": \"semi_technical\",\n      \"stage\": \"actively_building\",\n      \"first_user\": \"freelancers and small agencies\",\n      \"geography\": {\"country\": \"United Kingdom\"}\n    },\n    \"expected_checks\": [\n      \"flag: legaltech -> unauthorized legal advice risk\",\n      \"ask about liability disclaimers\"\n    ]\n  },\n  {\n    \"id\": \"T3_edge_long_text_6\",\n    \"input\": {\n      \"q1\": \"A mental wellness chatbot that combines CBT techniques with mood tracking and optional human therapist escalation\",\n      \"q2\": \"People experiencing mild anxiety often want immediate support but cannot access therapy quickly.\",\n      \"q3\": \"healthtech\",\n      \"q4\": \"semi technical\",\n      \"q5\": \"Early prototype\",\n      \"q6\": \"Young adults experiencing work stress\",\n      \"q7\": \"Germany\"\n    },\n    \"normalized\": {\n      \"product\": \"ai mental wellness chatbot with therapist escalation\",\n      \"problem\": \"users need accessible early mental health support\",\n      \"sector\": \"healthtech\",\n      \"technical_background\": \"semi_technical\",\n      \"stage\": \"prototype\",\n      \"first_user\": \"young professionals with anxiety\",\n      \"geography\": {\"country\": \"Germany\"}\n    },\n    \"expected_checks\": [\n      \"flag: mental health -> clinical claims risk\",\n      \"ask about GDPR and health data protection\"\n    ]\n  },\n  {\n    \"id\": \"T3_edge_long_text_7\",\n    \"input\": {\n      \"q1\": \"A SaaS tool that analyzes Slack and email communication patterns to detect team burnout and productivity risks\",\n      \"q2\": \"Managers often fail to notice early signs of employee burnout until performance drops.\",\n      \"q3\": \"future of work\",\n      \"q4\": \"technical\",\n      \"q5\": \"Actively building\",\n      \"q6\": \"Startup teams with remote employees\",\n      \"q7\": \"United States\"\n    },\n    \"normalized\": {\n      \"product\": \"ai workplace burnout detection platform\",\n      \"problem\": \"companies struggle to detect early employee burnout signals\",\n      \"sector\": \"future_of_work\",\n      \"technical_background\": \"technical\",\n      \"stage\": \"actively_building\",\n      \"first_user\": \"remote startup teams\",\n      \"geography\": {\"country\": \"United States\"}\n    },\n    \"expected_checks\": [\n      \"flag: workplace monitoring ethics\",\n      \"ask about employee consent\"\n    ]\n  },\n  {\n    \"id\": \"T3_edge_long_text_8\",\n    \"input\": {\n      \"q1\": \"An AI tutor that adapts math lessons dynamically based on student mistakes and attention patterns captured through webcam and interaction data\",\n      \"q2\": \"Students struggle with one-size-fits-all math teaching and fall behind without personalized attention.\",\n      \"q3\": \"edtech\",\n      \"q4\": \"technical\",\n      \"q5\": \"MVP with small classroom pilots\",\n      \"q6\": \"Middle school students needing math support\",\n      \"q7\": \"United Kingdom\"\n    },\n    \"normalized\": {\n      \"product\": \"ai adaptive math tutoring system\",\n      \"problem\": \"students need personalized math instruction\",\n      \"sector\": \"edtech\",\n      \"technical_background\": \"technical\",\n      \"stage\": \"mvp\",\n      \"first_user\": \"middle school students\",\n      \"geography\": {\"country\": \"United Kingdom\"}\n    },\n    \"expected_checks\": [\n      \"flag: child data privacy\",\n      \"ask about COPPA or similar regulations\"\n    ]\n  },\n  {\n    \"id\": \"T3_edge_long_text_9\",\n    \"input\": {\n      \"q1\": \"A real estate AI tool that estimates renovation ROI by analyzing property photos, local market trends, and contractor cost databases\",\n      \"q2\": \"Homeowners struggle to estimate whether renovations will actually increase property value.\",\n      \"q3\": \"proptech\",\n      \"q4\": \"semi technical\",\n      \"q5\": \"Exploring idea\",\n      \"q6\": \"Homeowners considering renovations\",\n      \"q7\": \"United States\"\n    },\n    \"normalized\": {\n      \"product\": \"ai renovation roi estimation platform\",\n      \"problem\": \"homeowners cannot easily predict renovation value impact\",\n      \"sector\": \"proptech\",\n      \"technical_background\": \"semi_technical\",\n      \"stage\": \"idea_stage\",\n      \"first_user\": \"homeowners planning renovations\",\n      \"geography\": {\"country\": \"United States\"}\n    },\n    \"expected_checks\": [\n      \"check: property valuation disclaimers\",\n      \"ask about data source reliability\"\n    ]\n  },\n  {\n    \"id\": \"T3_edge_long_text_10\",\n    \"input\": {\n      \"q1\": \"An AI travel planner that generates complete itineraries based on traveler preferences, weather forecasts, local events, and budget constraints\",\n      \"q2\": \"Travelers spend hours researching destinations and activities across multiple websites.\",\n      \"q3\": \"traveltech\",\n      \"q4\": \"non technical\",\n      \"q5\": \"Prototype\",\n      \"q6\": \"Millennial travelers planning short city trips\",\n      \"q7\": \"France\"\n    },\n    \"normalized\": {\n      \"product\": \"ai personalized travel itinerary planner\",\n      \"problem\": \"trip planning requires excessive manual research\",\n      \"sector\": \"traveltech\",\n      \"technical_background\": \"non_technical\",\n      \"stage\": \"prototype\",\n      \"first_user\": \"millennial city travelers\",\n      \"geography\": {\"country\": \"France\"}\n    },\n    \"expected_checks\": [\n      \"check: travel data integrations\",\n      \"ask about booking partner strategy\"\n    ]\n  }\n]\n```","x":-655,"y":320,"width":960,"height":2180},
