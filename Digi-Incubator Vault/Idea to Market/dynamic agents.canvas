{
	"nodes":[
		{"id":"3b222e48bc3fdddd","type":"text","text":"#### Layer 1: Intent\n**What does the user actually want?**","x":-660,"y":-340,"width":300,"height":120},
		{"id":"e3f5c73d36896e57","type":"text","text":"#### Layer 2: Planning\nWhat agent needs to exists, and in what order?","x":-660,"y":-160,"width":300,"height":120},
		{"id":"b59342ba770c6fdd","type":"text","text":"#### Layer 3: Execution\nAgents doing actual work and reporting back","x":-660,"y":20,"width":300,"height":120},
		{"id":"e6e636b77835458e","x":-1339,"y":-526,"width":439,"height":186,"type":"text","text":"```mermaid\nflowchart TD\n\n%% ── ENTRY ──────────────────────────────────────────────────────────────\n\nUSER([\"User — types idea\\n(multiline, END to finish)\"])\n\nUSER --> MAIN[\"main.py\\nread_idea() → run(idea)\"]\n\n  \n\n%% ── RUN LOOP ────────────────────────────────────────────────────────────\n\nMAIN --> INIT[\"graph.py · run()\\nInit SuperAgentState\\nnew uuid4 thread_id\\n_run_until_pause(state, config)\"]\n\n  \n\nINIT --> IA\n\n  \n\n%% ── SUPER AGENT GRAPH ───────────────────────────────────────────────────\n\nsubgraph SUPER [\"LangGraph StateGraph (MemorySaver checkpointer)\"]\n\n  \n\nIA[\"intent_analyzer\\nLLM structured output → IntentAnalysis\\ncore_problem · target_audience\\nproduct_type · domain_tags\\nregulatory_domains · geographic_scope · constraints\"]\n\n  \n\nIA --> HI\n\n  \n\nHI{{\"HITL · intent\\ninterrupt(checkpoint='intent', data=structured_intent)\\n─────────────────────\\nShow: structured intent fields\\nUser: approve / correct\"}}\n\n  \n\nHI -->|\"approved: True\"| BG\n\nHI -->|\"correction: '...'\"| IA\n\n  \n\nBG[\"blueprint_generator\\nLLM structured output → AgentBlueprint\\nClassify user_intent_type\\nGenerate agents[] from scratch\\nEach agent: sub_nodes · merge_prompt · parallel_group\"]\n\n  \n\nBG --> HB\n\n  \n\nHB{{\"HITL · blueprint\\ninterrupt(checkpoint='blueprint', data=blueprint)\\n─────────────────────\\nShow: intent_type · complexity · agents · risk_flags\\nUser: approve / feedback / remove:<id>\"}}\n\n  \n\nHB -->|\"approved: True\"| DE\n\nHB -->|\"correction: '...'\"| BG\n\nHB -->|\"remove_agent: '<id>'\"| DE\n\n  \n\nDE[\"dag_executor\\nSort agents by parallel_group int\\nasyncio.gather per group in order\"]\n\n  \n\nDE --> DYN\n\n  \n\nsubgraph DYN [\"Dynamic Agent Execution — per parallel_group wave\"]\n\ndirection LR\n\n  \n\nsubgraph G1 [\"parallel_group = 1 — asyncio.gather\"]\n\nA1[\"run_dynamic_agent(agent_A)\"]\n\nA2[\"run_dynamic_agent(agent_B)\"]\n\nend\n\n  \n\nsubgraph G2 [\"parallel_group = 2 — asyncio.gather (after group 1)\"]\n\nB1[\"run_dynamic_agent(agent_C)\\n(depends_on: agent_A)\"]\n\nend\n\n  \n\nG1 --> G2\n\nend\n\n  \n\nDYN --> CR\n\n  \n\nCR[\"critic\\nLLM structured output → CriticOutput\\nConflicts: agent_1 vs agent_2 · severity 1-10 · auto_resolvable\\nGaps · overall_confidence\\nneeds_human_review if severity >= 7\"]\n\n  \n\nCR -->|\"awaiting_human = True\"| HC\n\nCR -->|\"awaiting_human = False\"| FS\n\n  \n\nHC{{\"HITL · critic\\ninterrupt(checkpoint='critic', data=critic_feedback)\\n─────────────────────\\nShow: confidence · gaps · conflicts list\\nUser: approve / resolution notes\"}}\n\n  \n\nHC --> FS\n\n  \n\nFS[\"final_synthesizer\\nLLM.invoke → markdown report\\n8 sections: Executive Summary · Market · Product\\nBusiness Model · Legal · GTM · Roadmap · Risk\\nSave to outputs/<slug>_<ts>/final_report.md\"]\n\n  \n\nFS --> SEND_END([\"END\"])\n\nend\n\n  \n\n%% ── DYNAMIC AGENT INTERNALS ─────────────────────────────────────────────\n\nsubgraph RDA [\"run_dynamic_agent(agent_spec, idea) — called per agent\"]\n\ndirection TB\n\n  \n\nFAN[\"Fan-out all SubNodes\\nasyncio.gather(*[run_sub_node(n) for n in agent_spec.sub_nodes])\"]\n\n  \n\nsubgraph SNS [\"SubNode execution — fully parallel\"]\n\ndirection LR\n\nSN1[\"SubNode 1\\nTavilySearch(query_1) — max_results=6, depth=advanced\\nTavilySearch(query_2)\\ncombined_context\\ncreate_model(node_id_output, **output_schema_fields)\\nLLM.with_structured_output(DynamicOutput)\\n→ {node_id, output: {fields, sources}}\"]\n\nSN2[\"SubNode 2\\n(same pattern)\"]\n\nSNN[\"SubNode N\\n(same pattern)\"]\n\nend\n\n  \n\nFAN --> SN1\n\nFAN --> SN2\n\nFAN --> SNN\n\n  \n\nSN1 & SN2 & SNN --> MERGE[\"Merge step\\nLLM.invoke(merge_prompt + sub_results JSON)\\nfree-form synthesis text\"]\n\nMERGE --> AOUT[(\"agent output\\n{agent_id,\\n output: {sub_node_results, synthesis}}\")]\n\nend\n\n  \n\n%% ── HITL LOOP (graph.py _run_until_pause) ──────────────────────────────\n\nsubgraph HLOOP [\"graph.py · _run_until_pause() — stream consumption loop\"]\n\ndirection TB\n\nRL[\"graph.stream(input_data, config, stream_mode='values')\"]\n\nRL --> CHK{\"__interrupt__\\nin event?\"}\n\nCHK -->|\"No\"| DONE_CHK{\"stream\\nexhausted?\"}\n\nDONE_CHK -->|\"Yes\"| RET_NONE([\"return None\\n→ run complete\"])\n\nDONE_CHK -->|\"No\"| RL\n\nCHK -->|\"Yes — same checkpoint\\nas skip_checkpoint\"| RETRY[\"Re-emitted interrupt\\nCommand(resume=skip_resume_val)\\n→ retry stream\"]\n\nRETRY --> RL\n\nCHK -->|\"Yes — new checkpoint\"| RET_EVT([\"return event\\n→ _handle_interrupt(event)\\n→ user input\\n→ Command(resume=resume_val)\"])\n\nend\n\n  \n\n%% ── STATE SHAPE ─────────────────────────────────────────────────────────\n\nsubgraph STATE [\"SuperAgentState (TypedDict)\"]\n\ndirection LR\n\nSF[\"raw_idea · structured_intent · blueprint\\nagent_outputs: Annotated[list, operator.add]\\ncritic_feedback · final_report\\nhitl_override · awaiting_human\\ncurrent_checkpoint · intent_feedback · blueprint_feedback\"]\n\nend\n\n  \n\n%% ── OUTPUT ──────────────────────────────────────────────────────────────\n\nSEND_END --> OUT[\"main.py\\nPanel(report_md) → console\\nreport saved to: output_path\"]\n\n  \n\n%% ── CONNECTIONS TO INTERNALS ────────────────────────────────────────────\n\nDE -.->|\"calls\"| RDA\n\nINIT -.->|\"drives\"| HLOOP\n\nSUPER -.->|\"reads/writes\"| STATE\n```"}
	],
