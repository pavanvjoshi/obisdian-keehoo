			"y":1240,
			"width":2500,
			"height":1360
		},
		{
			"id":"55ddf820c5a57f54",
			"styleAttributes":{},
			"text":"## Lean Canvas\nhelps startup founders mitigate the risk and uncertainty associated with the product inception.",
			"type":"text",
			"x":-440,
			"y":1280,
			"width":1640,
			"height":140
		},
		{
			"id":"ad55899e121d0026",
			"styleAttributes":{},
			"text":"## 4. Solution\nOutline possible solution for each problem",
			"type":"text",
			"x":20,
			"y":1560,
			"width":300,
			"height":200
		},
		{
			"id":"a927aa0f04a843a6",
			"styleAttributes":{},
			"text":"## 1. Customer Segments\n1. list your target customers and users\n2. early adapters\n\t1. list the characteristics of your ideal customers",
			"type":"text",
			"x":1340,
			"y":1560,
			"width":500,
			"height":480
		},
		{
			"id":"cfe7bfdc6fcf0dfe",
			"styleAttributes":{},
			"text":"## 2. Problem\n1. List your customer's top 3 problems\n2. Existing alternatives\n\t1. list how these problems solved today",
			"type":"text",
			"x":-440,
			"y":1560,
			"width":420,
			"height":480
		},
		{
			"id":"366a3c4c30280557",
			"styleAttributes":{},
			"text":"## 9. Unfair Advantage\nsomething that cannot be easily copied or bought ",
			"type":"text",
			"x":860,
			"y":1560,
			"width":440,
			"height":200
		},
		{
			"id":"0e272c9219b537a7",
			"styleAttributes":{},
			"text":"## 6. Channels\nlist your paths to customers",
			"type":"text",
			"x":860,
			"y":1790,
			"width":440,
			"height":250
		},
		{
			"id":"32d5e9bab82b8780",
			"styleAttributes":{},
			"text":"## 7. Key Metrics\nList your key numbers, that tell you how your business is doing\n",
			"type":"text",
			"x":20,
			"y":1790,
			"width":300,
			"height":250
		},
		{
			"id":"4f6b7bfb2c348291",
			"styleAttributes":{},
			"text":"## 5. Unique Value Proposition\n1. single, clear, compelling message that turns unaware visitor into an interested prospect\n2. High level Concept\n\t1. List your X for Y analogy\n\t\t1. example : youtube = flicker for videos\n\n",
			"type":"text",
			"x":360,
			"y":1560,
			"width":460,
			"height":480
		},
		{
			"id":"0cd32c568655ec11",
			"styleAttributes":{},
			"text":"## 8. Cost structure\nlist your fixed and variable costs",
			"type":"text",
			"x":-440,
			"y":2080,
			"width":1030,
			"height":280
		},
		{
			"id":"5ae7dc1b0e1402c0",
			"styleAttributes":{},
			"text":"summary of lean canvas after completion of 9 steps",
			"type":"text",
			"x":1340,
			"y":2440,
			"width":520,
			"height":80,
			"color":"4"
		},
		{
			"id":"d1dd795770781ecb",
			"styleAttributes":{},
			"text":"## 3. Revenue Streams\nlist your source of revenue",
			"type":"text",
			"x":640,
			"y":2080,
			"width":1200,
			"height":280
		},
