		{"id":"74623e3079bf5e98","x":-154,"y":-249,"width":854,"height":2989,"type":"text","text":"```ini\n.\n\n└── i2mproject_root/\n\n├── frontend\n\n└── backend/\n\n├── app/\n\n│ ├── main.py # Entry point\n\n│ ├── modules/\n\n│ │ ├── idea_intake/ # Module 1 Idea Intake\n\n│ │ │ ├── domain/ # Entites, objects, classes, ports etc..\n\n│ │ │ ├── application/ # Core logic/serivces\n\n│ │ │ ├── infrastructure/ # LLMs, databases, tools etc.\n\n│ │ │ └── presentation/ # Schemas and Routers\n\n│ │ ├── swarm_orchestration/ # Module 2 Orchestration\n\n│ │ │ ├── domain/\n\n│ │ │ ├── application/\n\n│ │ │ ├── infrastructure/\n\n│ │ │ └── presentation/\n\n│ │ ├── market_research/ # Module 3 Market research\n\n│ │ │ ├── domain/\n\n│ │ │ ├── application/\n\n│ │ │ ├── infrastructure/\n\n│ │ │ └── presentation/\n\n│ │ ├── requirements/ # Module 4 Requirements\n\n│ │ │ ├── domain/\n\n│ │ │ ├── application/\n\n│ │ │ ├── infrastructure/\n\n│ │ │ └── presentation/\n\n│ │ ├── investment/ # Module 5 Investments\n\n│ │ │ ├── domain/\n\n│ │ │ ├── application/\n\n│ │ │ ├── infrastructure/\n\n│ │ │ └── presentation/\n\n│ │ ├── marketing/ # Module 6 Marketing\n\n│ │ │ ├── domain/\n\n│ │ │ ├── application/\n\n│ │ │ ├── infrastructure/\n\n│ │ │ └── presentation/\n\n│ │ ├── sales/ # Module 7 Sales\n\n│ │ │ ├── domain/\n\n│ │ │ ├── application/\n\n│ │ │ ├── infrastructure/\n\n│ │ │ └── presentation/\n\n│ │ ├── development/ # Module 8 Development\n\n│ │ │ ├── domain/\n\n│ │ │ ├── application/\n\n│ │ │ ├── infrastructure/\n\n│ │ │ └── presentation/\n\n│ │ ├── report_generation/ # Module 9 Report generation\n\n│ │ │ ├── domain/\n\n│ │ │ ├── application/\n\n│ │ │ ├── infrastructure/\n\n│ │ │ └── presentation/\n\n│ │ └── auth/ # Module 10 auth\n\n│ │ ├── domain/\n\n│ │ ├── application/\n\n│ │ ├── infrastructure/\n\n│ │ └── presentation/\n\n│ └── shared/ # Configs etc.\n\n├── tests/\n\n├── .gitignore\n\n└── .env\n```"},
		{"id":"6c8c93056d8ee58e","x":1472,"y":132,"width":728,"height":1368,"type":"text","text":"```markdownx\n. ├── i2mproject_root/ ├── ├── frontend/ └── └── backend/ ├── ├── app/ ├── │ ├── main.py # FastAPI init ├── │ │ ├── │ ├── modules/ ├── │ │ │ ├── │ │ ├── idea_intake/ # ─── MODULE: Idea Intake ─────────────────────────────── ├── │ │ │ ├── domain/ # ⚪ LAYER 1 — Pure Python · Zero external imports ├── │ │ │ │ ├── entities.py # IdeaSubmission(id, raw_text, status, created_at) ├── │ │ │ │ └── ports.py # IIdeaRepository(save, find_by_id) ├── │ │ │ ├── application/ # 🟡 LAYER 2 — Depends only on domain/ ├── │ │ │ │ └── submit_idea.py # SubmitIdeaUseCase · validates input · publishes IdeaSubmitted event ├── │ │ │ ├── infrastructure/ # 🔴 LAYER 3 — Implements ports · allowed to import libs ├── │ │ │ │ └── database/ ├── │ │ │ │ └── repository.py # IdeaRepository(IIdeaRepository) · SQLAlchemy ORM ├── │ │ │ └── presentation/ # 🔵 LAYER 4 — HTTP boundary · calls use cases only ├── │ │ │ ├── routes.py # POST /idea/submit ├── │ │ │ └── schemas.py # IdeaSubmitRequest · IdeaSubmitResponse ├── │ │ │ ├── │ │ ├── swarm_orchestration/ # ─── MODULE: Swarm Orchestration ────────────────────── ├── │ │ │ ├── domain/ # ⚪ LAYER 1 ├── │ │ │ │ ├── entities.py # SwarmRun(id, idea_id, status, steps[]) ├── │ │ │ │ │ # AgentStep(agent_name, input, output, timestamp) ├── │ │ │ │ │ # SwarmStatus(PENDING·RUNNING·COMPLETED·FAILED) ├── │ │ │ │ └── ports.py # ISwarmRepository(save, find_by_id, update_status) ├── │ │ │ │ # IAgentRunner(run_agent(name, context) → AgentOutput) ├── │ │ │ ├── application/ # 🟡 LAYER 2 ├── │ │ │ │ ├── run_swarm.py # RunSwarmUseCase · listens to IdeaSubmitted ├── │ │ │ │ │ # · sequences agents · publishes SwarmCompleted ├── │ │ │ │ ├── swarm_service.py # SwarmCoordinatorService · parallel vs sequential logic ├── │ │ │ │ └── get_swarm_status.py # GetSwarmStatusUseCase · returns SwarmRun for polling ├── │ │ │ ├── infrastructure/ # 🔴 LAYER 3 ├── │ │ │ │ ├── llms/ ├── │ │ │ │ │ └── openai_runner.py # OpenAIAgentRunner(IAgentRunner) · builds prompt per agent ├── │ │ │ │ └── database/ ├── │ │ │ │ └── repository.py # SwarmRunRepository(ISwarmRepository) ├── │ │ │ └── presentation/ # 🔵 LAYER 4 ├── │ │ │ ├── routes.py # GET /swarm/status/{idea_id} ├── │ │ │ └── schemas.py # SwarmStatusResponse · AgentStepResponse ├── │ │ │ ├── │ │ ├── market_research/ # ─── MODULE: Agent 1 — Market Research ──────────────── ├── │ │ │ ├── domain/ # ⚪ LAYER 1 ├── │ │ │ │ ├── entities.py # MarketReport(id, run_id, tam, competitors[], trends[]) ├── │ │ │ │ └── ports.py # IMarketResearchRepository ├── │ │ │ │ # IWebSearchTool(search(query) → SearchResults) ├── │ │ │ ├── application/ # 🟡 LAYER 2 ├── │ │ │ │ └── research_service.py # RunMarketResearchUseCase ├── │ │ │ │ # · calls IWebSearchTool + IAgentRunner ├── │ │ │ │ # · saves MarketReport ├── │ │ │ │ # · publishes MarketReportReady event ├── │ │ │ ├── infrastructure/ # 🔴 LAYER 3 ├── │ │ │ │ ├── llms/ ├── │ │ │ │ │ └── openai_client.py # Market research prompt template + OpenAI call ├── │ │ │ │ ├── tools/ ├── │ │ │ │ │ └── web_search.py # WebSearchTool(IWebSearchTool) · Tavily / SerpAPI ├── │ │ │ │ └── database/ ├── │ │ │ │ └── repository.py # MarketResearchRepository ├── │ │ │ └── presentation/ # 🔵 LAYER 4 (internal only, no public route needed) ├── │ │ │ └── schemas.py # MarketReportSchema (used by report_generation) ├── │ │ │ ├── │ │ ├── requirements/ # ─── MODULE: Agent 2 — Requirements ────────────────── ├── │ │ │ ├── domain/ # ⚪ LAYER 1 ├── │ │ │ │ ├── entities.py # BRD(id, run_id, business_objectives, user_stories[]) ├── │ │ │ │ │ # SRS(id, run_id, functional_reqs[], non_functional_reqs[]) ├── │ │ │ │ └── ports.py # IBRDRepository · ISRSRepository ├── │ │ │ ├── application/ # 🟡 LAYER 2 ├── │ │ │ │ └── requirements_service.py # RunRequirementsUseCase ├── │ │ │ │ # · listens to MarketReportReady ├── │ │ │ │ # · generates BRD + SRS ├── │ │ │ │ # · publishes RequirementsReady ├── │ │ │ ├── infrastructure/ # 🔴 LAYER 3 ├── │ │ │ │ ├── llms/ ├── │ │ │ │ │ └── openai_client.py ├── │ │ │ │ └── database/ ├── │ │ │ │ └── repository.py ├── │ │ │ └── presentation/ ├── │ │ │ └── schemas.py ├── │ │ │ ├── │ │ ├── investment/ # ─── MODULE: Agent 3 — Investment ──────────────────── ├── │ │ │ ├── domain/ # ⚪ LAYER 1 ├── │ │ │ │ ├── entities.py # InvestmentAnalysis(id, run_id, funding_stage, ├── │ │ │ │ │ # burn_rate, valuation_range, investor_profile) ├── │ │ │ │ └── ports.py # IInvestmentRepository ├── │ │ │ ├── application/ # 🟡 LAYER 2 ├── │ │ │ │ └── investment_service.py # RunInvestmentUseCase ├── │ │ │ │ # · runs in parallel with market_research ├── │ │ │ │ # · publishes InvestmentAnalysisReady ├── │ │ │ ├── infrastructure/ # 🔴 LAYER 3 ├── │ │ │ │ ├── llms/ ├── │ │ │ │ │ └── openai_client.py ├── │ │ │ │ └── database/ ├── │ │ │ │ └── repository.py ├── │ │ │ └── presentation/ ├── │ │ │ └── schemas.py ├── │ │ │ ├── │ │ ├── marketing/ # ─── MODULE: Agent 5 — Marketing ───────────────────── ├── │ │ │ ├── domain/ # ⚪ LAYER 1 ├── │ │ │ │ ├── entities.py # MarketingPlan(id, run_id, positioning, ├── │ │ │ │ │ # channels[], gtm_strategy) ├── │ │ │ │ │ # GTMPlan(id, run_id, launch_phases[], kpis[]) ├── │ │ │ │ └── ports.py # IMarketingRepository · IGTMRepository ├── │ │ │ ├── application/ # 🟡 LAYER 2 ├── │ │ │ │ └── marketing_service.py # RunMarketingUseCase ├── │ │ │ │ # · listens to InvestmentAnalysisReady ├── │ │ │ │ # · generates MarketingPlan + GTMPlan ├── │ │ │ │ # · publishes MarketingPlanReady ├── │ │ │ ├── infrastructure/ # 🔴 LAYER 3 ├── │ │ │ │ ├── llms/ ├── │ │ │ │ │ └── openai_client.py ├── │ │ │ │ └── database/ ├── │ │ │ │ └── repository.py ├── │ │ │ └── presentation/ ├── │ │ │ └── schemas.py ├── │ │ │ ├── │ │ ├── sales/ # ─── MODULE: Agent 6 — Sales ───────────────────────── ├── │ │ │ ├── domain/ # ⚪ LAYER 1 ├── │ │ │ │ ├── entities.py # SalesPlan(id, run_id, icp, revenue_model, ├── │ │ │ │ │ # pricing_strategy, sales_channels[]) ├── │ │ │ │ └── ports.py # ISalesRepository ├── │ │ │ ├── application/ # 🟡 LAYER 2 ├── │ │ │ │ └── sales_service.py # RunSalesUseCase ├── │ │ │ │ # · listens to InvestmentAnalysisReady ├── │ │ │ │ # · runs parallel to marketing ├── │ │ │ │ # · publishes SalesPlanReady ├── │ │ │ ├── infrastructure/ # 🔴 LAYER 3 ├── │ │ │ │ ├── llms/ ├── │ │ │ │ │ └── openai_client.py ├── │ │ │ │ └── database/ ├── │ │ │ │ └── repository.py ├── │ │ │ └── presentation/ ├── │ │ │ └── schemas.py ├── │ │ │ ├── │ │ ├── development/ # ─── MODULE: Agent 4 — Development ─────────────────── ├── │ │ │ ├── domain/ # ⚪ LAYER 1 ├── │ │ │ │ ├── entities.py # TechArchitecture(id, run_id, tech_stack[], ├── │ │ │ │ │ # system_design, api_contracts[], db_schema) ├── │ │ │ │ └── ports.py # IDevelopmentRepository ├── │ │ │ ├── application/ # 🟡 LAYER 2 ├── │ │ │ │ └── development_service.py # RunDevelopmentUseCase ├── │ │ │ │ # · listens to RequirementsReady ├── │ │ │ │ # · listens to MarketingPlanReady ├── │ │ │ │ # · listens to SalesPlanReady ├── │ │ │ │ # · only runs when ALL 3 are ready ├── │ │ │ │ # · publishes DevelopmentReady ├── │ │ │ ├── infrastructure/ # 🔴 LAYER 3 ├── │ │ │ │ ├── llms/ ├── │ │ │ │ │ └── openai_client.py ├── │ │ │ │ └── database/ ├── │ │ │ │ └── repository.py ├── │ │ │ └── presentation/ ├── │ │ │ └── schemas.py ├── │ │ │ ├── │ │ ├── report_generation/ # ─── MODULE: Report Generation ──────────────────────── ├── │ │ │ ├── domain/ # ⚪ LAYER 1 ├── │ │ │ │ ├── entities.py # MVPReport(id, run_id, feature_list[], ├── │ │ │ │ │ # architecture_overview, tech_stack, timeline) ├── │ │ │ │ │ # PitchDeck(id, run_id, slides[], investor_summary) ├── │ │ │ │ └── ports.py # IReportRepository ├── │ │ │ │ # IDocumentExporter(export_pdf · export_pptx) ├── │ │ │ ├── application/ # 🟡 LAYER 2 ├── │ │ │ │ └── generate_report.py # GenerateReportUseCase ├── │ │ │ │ # · listens to SwarmCompleted ├── │ │ │ │ # · fetches all artifacts by run_id ├── │ │ │ │ # · calls IDocumentExporter ├── │ │ │ │ # · saves MVPReport + PitchDeck ├── │ │ │ │ # · updates SwarmRun → REPORT_READY ├── │ │ │ ├── infrastructure/ # 🔴 LAYER 3 ├── │ │ │ │ ├── llms/ ├── │ │ │ │ │ └── openai_client.py # Final synthesis prompt ├── │ │ │ │ ├── exporters/ ├── │ │ │ │ │ ├── pdf_exporter.py # IDocumentExporter → PDF via WeasyPrint ├── │ │ │ │ │ └── pptx_exporter.py # IDocumentExporter → PPTX via python-pptx ├── │ │ │ │ └── database/ ├── │ │ │ │ └── repository.py ├── │ │ │ └── presentation/ # 🔵 LAYER 4 ├── │ │ │ ├── routes.py # GET /report/{run_id}/mvp ├── │ │ │ │ # GET /report/{run_id}/pitch-deck ├── │ │ │ │ # GET /report/{run_id}/download ├── │ │ │ └── schemas.py # MVPReportResponse · PitchDeckResponse ├── │ │ │ ├── │ │ └── auth/ # ─── MODULE: Auth ───────────────────────────────────── ├── │ │ ├── domain/ # ⚪ LAYER 1 ├── │ │ │ ├── entities.py # User(id, email, hashed_password, plan) ├── │ │ │ └── ports.py # IUserRepository · ITokenService ├── │ │ ├── application/ # 🟡 LAYER 2 ├── │ │ │ ├── register.py # RegisterUseCase ├── │ │ │ └── login.py # LoginUseCase · returns JWT ├── │ │ ├── infrastructure/ # 🔴 LAYER 3 ├── │ │ │ ├── jwt_service.py # ITokenService → python-jose ├── │ │ │ └── database/ ├── │ │ │ └── repository.py # UserRepository ├── │ │ └── presentation/ # 🔵 LAYER 4 ├── │ │ ├── routes.py # POST /auth/register · POST /auth/login ├── │ │ └── schemas.py # RegisterRequest · LoginResponse ├── │ │ ├── │ └── shared/ # ─── SHARED KERNEL (intentionally thin) ─────────────── ├── │ ├── config.py # Settings(BaseSettings) · env vars · LLM config ├── │ ├── database.py # SQLAlchemy engine · session factory · Base model ├── │ ├── events.py # DomainEvent(base dataclass) ├── │ │ # InMemoryEventBus(publish · subscribe · handlers dict) ├── │ │ # ─── Events ─────────────────────────────────────── ├── │ │ # IdeaSubmitted(idea_id) ├── │ │ # MarketReportReady(report_id, run_id) ├── │ │ # RequirementsReady(brd_id, srs_id, run_id) ├── │ │ # InvestmentAnalysisReady(analysis_id, run_id) ├── │ │ # MarketingPlanReady(plan_id, run_id) ├── │ │ # SalesPlanReady(plan_id, run_id) ├── │ │ # DevelopmentReady(arch_id, run_id) ├── │ │ # SwarmCompleted(run_id) ├── │ └── base_entities.py # BaseEntity(id, created_at, updated_at) ├── │ # BaseRepository(ABC · save · find_by_id) ├── │ └── └── tests/ ├── ├── unit/ ├── │ ├── idea_intake/ # test submit_idea.py with mocked IIdeaRepository ├── │ ├── swarm_orchestration/ # test run_swarm.py with mocked IAgentRunner ├── │ ├── market_research/ # test research_service.py with mocked IWebSearchTool ├── │ ├── requirements/ # test requirements_service.py ├── │ ├── investment/ # test investment_service.py ├── │ ├── marketing/ # test marketing_service.py ├── │ ├── sales/ # test sales_service.py ├── │ ├── development/ # test development_service.py · gate logic for 3 events ├── │ └── report_generation/ # test generate_report.py with mocked IDocumentExporter └── └── integration/ ├── ├── test_full_swarm_flow.py # Submits raw idea · asserts REPORT_READY status └── └── test_agent_sequencing.py # Verifies parallel + sequential event chain\n```"}
