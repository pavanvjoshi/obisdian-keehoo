		{"id":"10e4143368b474c8","type":"text","text":"```json\n{\n   \"_id\":{\n      \"$oid\":\"69805bd39cf711824a795d9d\"\n   },\n   \"dataset_id\":\"<UUID>\",\n   \"storage_id\":\"<UUID>\",\n   \"dataset_name\":\"<name of the dataset>\",\n   \"dataset_type\":\"Image\",\n   \"layout_type\":\"Object store\",\n   \"file_extension\":\".jpg\",\n   \"has_header\":false,\n   \"schema_version\":1,\n   \"status\":\"active\",\n   \"dataset_path\":\"<path_to_customer_dataset>\",\n   \"ssot_system\":false,\n   \"format_specifiers\":{\n      \"type\":\"image\",\n      \"allowed_formats\":[\n         \"jpeg\",\n         \"png\",\n         \"webp\",\n         \"tiff\",\n         \"heic\"\n      ],\n      \"dimensions\":{\n         \"min_width_px\":1,\n         \"min_height_px\":1,\n         \"max_width_px\":null,\n         \"max_height_px\":null\n      },\n      \"color\":{\n         \"color_space\":[\n            \"sRGB\",\n            \"AdobeRGB\",\n            \"ProPhotoRGB\"\n         ],\n         \"bit_depth\":[\n            8,\n            16\n         ],\n         \"has_alpha\":true\n      },\n      \"compression\":{\n         \"lossy\":true,\n         \"quality_range\":[\n            0,\n            100\n         ]\n      },\n      \"exif\":{\n         \"enabled\":true,\n         \"fields_indexed\":[\n            \"camera_make\",\n            \"camera_model\",\n            \"capture_datetime\",\n            \"gps.latitude\",\n            \"gps.longitude\"\n         ]\n      },\n      \"derivatives\":{\n         \"thumbnails\":[\n            {\n               \"name\":\"thumb_128\",\n               \"width\":128,\n               \"height\":128,\n               \"format\":\"jpeg\"\n            },\n            {\n               \"name\":\"thumb_512\",\n               \"width\":512,\n               \"height\":512,\n               \"format\":\"jpeg\"\n            }\n         ],\n         \"web_optimized\":{\n            \"format\":\"webp\",\n            \"quality\":80\n         }\n      },\n      \"validation\":{\n         \"checksum_required\":true,\n         \"max_file_size_mb\":50\n      }\n   },\n   \"created_at\":\"2026-02-02T09:15:30Z\",\n   \"created_by\":\"system\",\n   \"updated_at\":\"2026-02-05T14:42:10Z\",\n   \"updated_by\":\"admin_user_01\"\n}\n```","x":-420,"y":-183,"width":560,"height":643},
		{"id":"88c5782371c926c9","type":"text","text":"```json\n{\n   \"_id\":{\n      \"$oid\":\"69805bd39cf711824a795d9d\"\n   },\n   \"dataset_id\":\"<UUID>\",\n   \"storage_id\":\"<UUID>\",\n   \"dataset_name\":\"<name of the dataset>\",\n   \"dataset_type\":\"Video\",\n   \"layout_type\":\"Object Store\",\n   \"file_extension\":\"mp4\",\n   \"has_header\":false,\n   \"schema_version\":1,\n   \"status\":\"active\",\n   \"dataset_path\":\"<path_to_customer_dataset>\",\n   \"ssot_system\":false,\n   \"format_specifiers\":{\n      \"type\":\"video\",\n      \"allowed_containers\":[\n         \"mp4\",\n         \"mov\",\n         \"mkv\",\n         \"webm\"\n      ],\n      \"allowed_video_codecs\":[\n         \"h264\",\n         \"h265\",\n         \"vp9\",\n         \"av1\"\n      ],\n      \"allowed_audio_codecs\":[\n         \"aac\",\n         \"opus\",\n         \"mp3\"\n      ],\n      \"resolution\":{\n         \"min_width_px\":16,\n         \"min_height_px\":16,\n         \"max_width_px\":7680,\n         \"max_height_px\":4320\n      },\n      \"frame_rate\":{\n         \"min_fps\":1,\n         \"max_fps\":120\n      },\n      \"duration\":{\n         \"min_seconds\":0.1,\n         \"max_seconds\":null\n      },\n      \"bitrate\":{\n         \"max_video_kbps\":null,\n         \"max_audio_kbps\":null\n      },\n      \"audio\":{\n         \"required\":true,\n         \"max_channels\":8,\n         \"sample_rates_hz\":[\n            22050,\n            44100,\n            48000\n         ]\n      },\n      \"subtitles\":{\n         \"supported_formats\":[\n            \"srt\",\n            \"vtt\"\n         ],\n         \"multiple_languages\":true\n      },\n      \"derivatives\":{\n         \"thumbnails\":{\n            \"count\":5,\n            \"format\":\"jpeg\",\n            \"width\":320\n         },\n         \"poster_frame\":{\n            \"format\":\"jpeg\",\n            \"timestamp_seconds\":1\n         },\n         \"proxy_versions\":[\n            {\n               \"name\":\"360p\",\n               \"width\":640,\n               \"height\":360,\n               \"video_codec\":\"h264\"\n            },\n            {\n               \"name\":\"720p\",\n               \"width\":1280,\n               \"height\":720,\n               \"video_codec\":\"h264\"\n            }\n         ]\n      },\n      \"validation\":{\n         \"checksum_required\":true,\n         \"max_file_size_gb\":10\n      }\n   },\n   \"created_at\":\"2026-02-02T09:15:30Z\",\n   \"created_by\":\"system\",\n   \"updated_at\":\"2026-02-05T14:42:10Z\",\n   \"updated_by\":\"admin_user_01\"\n}\n```","x":220,"y":-183,"width":556,"height":643},
		{"id":"e9c22ede3bf5728d","type":"text","text":"```json\n{\n   \"_id\": {\"$oid\": \"69805bd39cf711824a795d9d\"},\n   \"dataset_id\": \"<UUID>\",\n   \"storage_id\": \"<UUID>\",\n   \"dataset_name\": \"<name of the dataset>\",\n   \"dataset_type\": \"Audio\",\n   \"layout_type\": \"Object Store\",\n   \"status\": \"active\",\n   \"dataset_path\": \"<path_to_customer_dataset>\",\n   \"format_specifiers\": {\n      \"type\": \"audio\",\n      \"allowed_containers\": [\"mp3\", \"wav\", \"flac\", \"m4a\", \"ogg\"],\n      \"allowed_codecs\": [\"mp3\", \"aac\", \"opus\", \"flac\", \"vorbis\"],\n      \"sample_rate\": {\n         \"min_hz\": 8000,\n         \"max_hz\": 192000,\n         \"preferred_hz\": [44100, 48000]\n      },\n      \"bit_depth\": [16, 24, 32],\n      \"channels\": {\n         \"min\": 1,\n         \"max\": 8\n      },\n      \"duration\": {\n         \"min_seconds\": 0.1,\n         \"max_seconds\": null\n      },\n      \"bitrate\": {\n         \"min_kbps\": 64,\n         \"max_kbps\": 320\n      },\n      \"derivatives\": {\n         \"waveform\": {\n            \"format\": \"png\",\n            \"width\": 1200,\n            \"height\": 200\n         },\n         \"preview\": {\n            \"duration_seconds\": 30,\n            \"format\": \"mp3\",\n            \"bitrate_kbps\": 128\n         }\n      },\n      \"validation\": {\n         \"checksum_required\": true,\n         \"max_file_size_mb\": 500\n      }\n   },\n   \"created_at\": \"2026-02-02T09:15:30Z\",\n   \"created_by\": \"system\",\n   \"updated_at\": \"2026-02-05T14:42:10Z\",\n   \"updated_by\": \"admin_user_01\"\n}\n```","x":860,"y":-183,"width":556,"height":643},
