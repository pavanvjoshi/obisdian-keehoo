		{"id":"9af9d95ab6bf4f4f","type":"text","text":"```json\n{\n  \"_id\": ObjectId(\"65c8f7e4b5a1c2d3e4f5g6h8\"),\n  \"entity_id\": \"urn:dataset:sales_db.public.customers\",\n  \"aspect_type\": \"table_schema\",\n  \"aspect_version\": \"1.0\",\n  \"created_at\": ISODate(\"2026-02-09T10:30:00Z\"),\n  \n  \"data\": {\n    \"database_info\": {\n      \"database\": \"sales_db\",\n      \"schema\": \"public\",\n      \"table_name\": \"customers\",\n      \"table_type\": \"dimension\",\n      \"catalog\": \"hive_metastore\"\n    },\n    \n    \"columns\": [\n      {\n        \"name\": \"customer_id\",\n        \"ordinal_position\": 1,\n        \"data_type\": \"INT\",\n        \"native_data_type\": \"INT\",\n        \"nullable\": false,\n        \"default_value\": null,\n        \n        \"constraints\": {\n          \"primary_key\": true,\n          \"foreign_key\": false,\n          \"unique\": true,\n          \"auto_increment\": true\n        },\n        \n        \"metadata\": {\n          \"description\": \"Unique customer identifier\",\n          \"tags\": [\"identifier\", \"primary_key\"],\n          \"business_name\": \"Customer ID\",\n          \"sample_values\": [1001, 1002, 1003, 1004, 1005]\n        },\n        \n        \"statistics\": {\n          \"distinct_count\": 100000,\n          \"null_count\": 0,\n          \"min_value\": 1,\n          \"max_value\": 100000,\n          \"avg_length\": null\n        }\n      },\n      {\n        \"name\": \"email\",\n        \"ordinal_position\": 2,\n        \"data_type\": \"VARCHAR\",\n        \"native_data_type\": \"VARCHAR(255)\",\n        \"nullable\": false,\n        \"default_value\": null,\n        \n        \"constraints\": {\n          \"primary_key\": false,\n          \"foreign_key\": false,\n          \"unique\": true,\n          \"auto_increment\": false\n        },\n        \n        \"metadata\": {\n          \"description\": \"Customer email address\",\n          \"tags\": [\"PII\", \"contact\", \"unique\"],\n          \"business_name\": \"Email Address\",\n          \"sample_values\": [\n            \"john.doe@example.com\",\n            \"jane.smith@example.com\",\n            \"alice.wong@example.com\"\n          ]\n        },\n        \n        \"statistics\": {\n          \"distinct_count\": 98500,\n          \"null_count\": 0,\n          \"min_value\": null,\n          \"max_value\": null,\n          \"avg_length\": 24\n        }\n      },\n      {\n        \"name\": \"first_name\",\n        \"ordinal_position\": 3,\n        \"data_type\": \"VARCHAR\",\n        \"native_data_type\": \"VARCHAR(100)\",\n        \"nullable\": true,\n        \"default_value\": null,\n        \n        \"constraints\": {\n          \"primary_key\": false,\n          \"foreign_key\": false,\n          \"unique\": false,\n          \"auto_increment\": false\n        },\n        \n        \"metadata\": {\n          \"description\": \"Customer first name\",\n          \"tags\": [\"PII\", \"name\"],\n          \"business_name\": \"First Name\",\n          \"sample_values\": [\"John\", \"Jane\", \"Alice\", \"Bob\"]\n        },\n        \n        \"statistics\": {\n          \"distinct_count\": 5420,\n          \"null_count\": 150,\n          \"min_value\": null,\n          \"max_value\": null,\n          \"avg_length\": 6\n        }\n      },\n      {\n        \"name\": \"last_name\",\n        \"ordinal_position\": 4,\n        \"data_type\": \"VARCHAR\",\n        \"native_data_type\": \"VARCHAR(100)\",\n        \"nullable\": true,\n        \"default_value\": null,\n        \n        \"constraints\": {\n          \"primary_key\": false,\n          \"foreign_key\": false,\n          \"unique\": false,\n          \"auto_increment\": false\n        },\n        \n        \"metadata\": {\n          \"description\": \"Customer last name\",\n          \"tags\": [\"PII\", \"name\"],\n          \"business_name\": \"Last Name\",\n          \"sample_values\": [\"Doe\", \"Smith\", \"Wong\", \"Johnson\"]\n        },\n        \n        \"statistics\": {\n          \"distinct_count\": 12340,\n          \"null_count\": 150,\n          \"min_value\": null,\n          \"max_value\": null,\n          \"avg_length\": 8\n        }\n      },\n      {\n        \"name\": \"country_id\",\n        \"ordinal_position\": 5,\n        \"data_type\": \"INT\",\n        \"native_data_type\": \"INT\",\n        \"nullable\": true,\n        \"default_value\": null,\n        \n        \"constraints\": {\n          \"primary_key\": false,\n          \"foreign_key\": false,\n          \"unique\": false,\n          \"auto_increment\": false\n        },\n        \n        \"metadata\": {\n          \"description\": \"Foreign key reference to countries table\",\n          \"tags\": [\"foreign_key_candidate\"],\n          \"business_name\": \"Country ID\",\n          \"sample_values\": [1, 2, 3, 5, 8]\n        },\n        \n        \"statistics\": {\n          \"distinct_count\": 195,\n          \"null_count\": 2500,\n          \"min_value\": 1,\n          \"max_value\": 250,\n          \"avg_length\": null\n        }\n      },\n      {\n        \"name\": \"created_at\",\n        \"ordinal_position\": 6,\n        \"data_type\": \"TIMESTAMP\",\n        \"native_data_type\": \"TIMESTAMP\",\n        \"nullable\": true,\n        \"default_value\": \"CURRENT_TIMESTAMP\",\n        \n        \"constraints\": {\n          \"primary_key\": false,\n          \"foreign_key\": false,\n          \"unique\": false,\n          \"auto_increment\": false\n        },\n        \n        \"metadata\": {\n          \"description\": \"Record creation timestamp\",\n          \"tags\": [\"audit\", \"temporal\"],\n          \"business_name\": \"Created At\",\n          \"sample_values\": [\n            \"2024-01-15T10:30:00Z\",\n            \"2024-02-20T14:45:00Z\",\n            \"2024-03-10T09:15:00Z\"\n          ]\n        },\n        \n        \"statistics\": {\n          \"distinct_count\": 98000,\n          \"null_count\": 0,\n          \"min_value\": \"2020-01-01T00:00:00Z\",\n          \"max_value\": \"2026-02-09T00:00:00Z\",\n          \"avg_length\": null\n        }\n      }\n    ],\n    \n    \"table_summary\": {\n      \"total_columns\": 6,\n      \"total_rows\": 100000,\n      \"partition_columns\": [],\n      \"clustering_columns\": [\"customer_id\"],\n      \"raw_ddl\": \"CREATE TABLE customers (\\n    customer_id INT PRIMARY KEY AUTO_INCREMENT,\\n    email VARCHAR(255) NOT NULL UNIQUE,\\n    first_name VARCHAR(100),\\n    last_name VARCHAR(100),\\n    country_id INT,\\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\\n);\"\n    }\n  }\n}\n```","x":316,"y":2560,"width":653,"height":840},
