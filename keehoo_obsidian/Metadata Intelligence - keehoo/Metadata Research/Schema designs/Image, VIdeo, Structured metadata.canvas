		{"id":"7252c933308a4e32","type":"text","text":"```json\n{\n  \"_id\": ObjectId(\"65c8f7e4b5a1c2d3e4f5g6h9\"),\n  \"entity_id\": \"urn:dataset:sales_db.public.customers\",\n  \"aspect_type\": \"inferred_metadata\",\n  \"aspect_version\": \"1.0\",\n  \"created_at\": ISODate(\"2026-02-09T10:30:00Z\"),\n  \n  \"data\": {\n    \"inferred_keys\": {\n      \"primary_key_candidates\": [\n        {\n          \"columns\": [\"customer_id\"],\n          \"confidence\": 0.98,\n          \"reasoning\": \"Column is 100% unique (distinct_count equals total_rows), non-nullable (null_count is 0), has auto_increment pattern, and follows standard naming convention with '_id' suffix. The data type INT is appropriate for primary keys.\"\n        }\n      ],\n      \n      \"foreign_key_candidates\": [\n        {\n          \"source_column\": \"country_id\",\n          \"target_table\": \"countries\",\n          \"target_column\": \"id\",\n          \"confidence\": 0.92,\n          \"reasoning\": \"Column name 'country_id' follows the pattern table_name_id which strongly suggests a foreign key relationship to 'countries' table. The distinct count (195) is reasonable for a countries reference table. Data type INT is compatible.\",\n          \"name_pattern_match\": true,\n          \"type_compatible\": true\n        }\n      ]\n    },\n    \n    \"embeddings\": {\n      \"table_summary_embedding\": [\n        0.0234, -0.0156, 0.0423, -0.0189, 0.0567, \n        0.0012, -0.0345, 0.0678, -0.0234, 0.0456,\n        \"... (768-dimensional vector continues)\"\n      ],\n      \"embedding_model\": \"text-embedding-ada-002\",\n      \"summary_text\": \"Customers table is the core dimension table storing customer profile information including contact details and registration data. This table serves as the primary entity for customer analytics and segmentation, containing PII data that requires GDPR compliance. It includes unique identifiers, email addresses, names, and references to geographic location through country relationships.\"\n    },\n    \n    \"semantic_classification\": {\n      \"business_domain\": \"customer\",\n      \"sub_domain\": \"crm\",\n      \"data_patterns\": [\"dimensional\", \"master_data\"],\n      \"suggested_tags\": [\"customer_master\", \"PII\", \"GDPR\", \"analytics\"],\n      \"confidence\": 0.89\n    }\n  }\n}\n```","x":1080,"y":2560,"width":720,"height":840},
