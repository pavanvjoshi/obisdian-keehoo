	"nodes":[
		{"id":"b5690d4976d1cf61","type":"group","x":-350,"y":-520,"width":3350,"height":1620,"label":"Metadata on data"},
		{"id":"92df26705dbf92c0","type":"group","x":-330,"y":-400,"width":3290,"height":960,"label":"Structured"},
		{"id":"2d3e07c4e4ed8139","type":"text","text":"```json\n{\n  \"dataset_id\": \"string\",\n  \"business_name\": \"string\",\n  \"description\": \"string\",\n  \"domain\": \"string\",\n  \"entity_type\": \"string\",\n  \"grain\": \"string\",\n  \"modality\": \"string\",\n  \"lifecycle_stage\": \"string\",\n  \"ssot_system\": \"string\",\n  \"data_owner\": \"string\",\n  \"sensitivity\": \"string\",\n  \"is_observed\": true,\n  \"embedding\": [\n    0.12,\n    -0.45,\n    0.88\n  ]\n}\n```","x":60,"y":2180,"width":560,"height":520},
		{"id":"e787763586d93153","type":"text","text":"### Metadata for Data (structured)\n\n#### dataset system\n\n```json\n{\n  \"data_system_id\": \"<UUID>\",\n  \"data_system_name\": \"<logical_name>\",\n  \"data_system_type\": \"structured|unstrucred\",\n  \"datasets\": [\n    {\n      \"dataset_id\": \"<UUID>\",\n      \"dataset_name\": \"<logical_dataset_name>\",\n      \"status\": \"active|inactive\"\n    },\n    {\n      \"dataset_id\": \"<UUID>\",\n      \"dataset_name\": \"<logical_dataset_name>\",\n      \"status\": \"active|inactive\"\n    }\n  ],\n  \"status\": \"active|inactive|deprecated\",\n  \"schema_version\": 1,\n  \"created_at\": \"<timestamp>\",\n  \"created_by\": \"\",\n  \"updated_at\": \"<timestamp>\",\n  \"updated_by\": \"\"\n}\n \n```","x":-280,"y":-340,"width":502,"height":740},
		{"id":"58f75107d53bebaa","type":"text","text":"### Metadata for Data (structured)\n### dataset\n```json\n{\n\"dataset_id\": \"<UUID>\",\n\"storage_id\": \"<UUID>\",\n\"dataset_name\": \"<logical_name>\",\n\"dataset_type\": \"structured\",\n\"layout_type\": \"single_table|multi_sheet\",\n\"file_extension\": \"csv|xlsx|xls|parquet\",\n\"has_header\": true,\n\"schema_version\": 1,\n\"status\": \"active\",\n\"dataset_path\": \"\",\n\"ssot_system\": true,\n\"format_specifiers\": { // this field may vary according to data files.\n  \"image_width\": 1920,\n  \"image_height\": 1080,\n  \"color_mode\": \"rgb\",\n  \"channels\": 3,\n  \"dpi\": 300\n},\n\"created_at\": \"<timestamp>\",\n\"created_by\": \"\",  //string data-type\n\"updated_at\": \"<timestamp>\",\n\"updated_by\": \"\",  //string data-type\n}\n```","x":280,"y":-340,"width":620,"height":780},
		{"id":"cb254874726edae1","type":"text","text":"### Metadata for Data (structured)\n\n#### dataset fields\n(one column inside a dataset)\n```json\n\"field_id\": \"<UUID>\",\n\"field_name\": \"<column_name>\",\n\"dataset_id\": \"<UUID>\",\n\"sensitivity\": {},\n\"status\": \"active\",\n\"field_type\": \"structured\"\n\"field_stats\": {\n\t\"is_unique\": true,\n\t\"is_primary_key\": false,\n\t\"nullable\": true,\n\t\"is_foreign_key\": false,\n\t\"sample_values\": [],\n\t\"data_type\": \"string|integer|decimal|date|timestamp|boolean\",\n\t\"record_counts\": 500,\n\t\"null_counts\": 20\n}\n\"created_at\": \"<timestamp>\",\n\"created_by\": \"\",  //string data-type\n\"updated_at\": \"<timestamp>\",\n\"updated_by\": \"\",  //string data-type\n```","x":960,"y":-352,"width":660,"height":680},
		{"id":"cf1b48588945591e","type":"text","text":"#### dataset processing\n\n```json\n{\n  \"dataset_id\": \"<UUID>\",\n  \"processing_type\": \"batch/streaming\",\n  \"frequency\": \"hourly\",\n  \"retention_hours\": 720,\n  \"late_arrival_policy\": \"accept\"\n}\n```","x":2240,"y":-340,"width":480,"height":268},
		{"id":"3809725a660b8e00","type":"text","text":"### Metadata for Data (structured)\n\n#### dataset relationship\n\n```json\n\"relationship_id\": \"<UUID>\",\n\"source\": {   //table-table, table-column\n\t\"storage_id\": \"<UUID>\",\n\t\"storage_name\": \"<storage name>\",\n\t\"field_id\": \"<UUID>\",\n\t\"field_name\": \"<field name>\",\n},\n\"target\": {\n\t\"storage_id\": \"<UUID>\",\n\t\"storage_name\": \"<storage name>\",\n\t\"field_id\": \"<UUID>\",\n\t\"field_name\": \"<field name>\",\n},\n\"relationship_scope\": \"Intra/Inter\",\n\"relationship\": \"foreign_key\",\n\"relationship_type\": \"one-to-one\",\n\"confidence_score\": 0.85,\n\"created_at\": \"<timestamp>\",\n\"created_by\": \"\",  //string data-type\n\"updated_at\": \"<timestamp>\",\n\"updated_by\": \"\",  //string data-type\n```","x":1680,"y":-340,"width":524,"height":656},
		{"id":"8eead5057f6bf8fd","type":"text","text":"#### ml outputs\n\n```json\n{\n  \"dataset_id\": \"ecom_orders\",\n  \"prediction_type\": \"fraud_risk\",\n  \"prediction_value\": \"high\",\n  \"model\": \"fraud_detection_v2\",\n  \"confidence\": 0.89,\n  \"prediction_ts\": \"2026-01-20T12:05:00Z\",\n  \"is_observed\": false\n}\n```","x":2240,"y":-36,"width":480,"height":352},
		{"id":"3175d455472513b9","type":"text","text":"```json\n{\n  \"field_id\": \"string\",\n  \"dataset_id\": \"string\",\n  \"physical_name\": \"string\",\n  \"business_name\": \"string\",\n  \"description\": \"string\",\n  \"logical_type\": \"metric\",\n  \"data_type\": \"string\",\n  \"unit\": \"string\",\n  \"is_key\": false,\n  \"is_filterable\": true,\n  \"is_aggregatable\": true,\n  \"synonyms\": \"string\",\n  \"example_values\": \"string\",\n  \"embedding\": [\n    0.21,\n    -0.09\n  ]\n}\n```","x":640,"y":2180,"width":420,"height":520},
		{"id":"306f6eb8c3abaed0","type":"text","text":"```json\n{\n  \"dataset_id\": \"string\",\n  \"processing_type\": \"streaming\",\n  \"load_type\": \"incremental\",\n  \"frequency\": \"hourly\",\n  \"event_time_field\": \"event_ts\",\n  \"watermark_column\": \"event_ts\",\n  \"late_arrival_policy\": \"drop\",\n  \"retention_hours\": 72,\n  \"ordering_guarantee\": \"partition\",\n  \"last_run_ts\": \"2025-01-01T10:00:00Z\"\n}\n```","x":1080,"y":2180,"width":380,"height":520},
		{"id":"ebc5f14df62d1954","type":"text","text":"```json\n{\n  \"dataset_id\": \"string\",\n  \"max_latency_ms\": 500,\n  \"freshness_minutes\": 5,\n  \"availability_pct\": 99.9,\n  \"expected_tps\": 10000,\n  \"drop_tolerance_pct\": 0.1\n}\n```","x":1480,"y":2180,"width":400,"height":520},
		{"id":"714eb6963f0fee91","type":"text","text":"```json\n{\n  \"dataset_id\": \"string\",\n  \"format\": \"mp4\",\n  \"codec\": \"h264\",\n  \"resolution\": \"1920x1080\",\n  \"frame_rate\": 30,\n  \"sample_rate\": 44100,\n  \"duration_seconds\": 3600,\n  \"language\": \"en\",\n  \"source_system\": \"camera_system\",\n  \"related_entity_id\": \"site_123\"\n}\n```","x":1900,"y":2180,"width":320,"height":520},
		{"id":"016f147839a21afc","type":"text","text":"```json\n{\n  \"enrichment_id\": \"string\",\n  \"dataset_id\": \"string\",\n  \"enrichment_type\": \"object_detection\",\n  \"model_name\": \"yolo\",\n  \"model_version\": \"v8\",\n  \"output_summary\": \"person detected\",\n  \"confidence_score\": 0.94,\n  \"inference_ts\": \"2025-01-01T10:05:00Z\",\n  \"embedding\": [\n    0.88,\n    -0.12\n  ]\n}\n```","x":2260,"y":2180,"width":360,"height":520},
		{"id":"ec92245464152c16","type":"text","text":"```json\n{\n  \"enrichment_id\": \"string\",\n  \"key_name\": \"object\",\n  \"key_value\": \"person\",\n  \"confidence_score\": 0.93,\n  \"time_range\": \"00:01:10-00:01:25\"\n}\n```","x":2640,"y":2180,"width":394,"height":249},
		{"id":"096990b2e380045d","type":"text","text":"```json\n{\n  \"dataset_id\": \"string\",\n  \"model_name\": \"churn_model\",\n  \"model_version\": \"v3\",\n  \"prediction_type\": \"churn_risk\",\n  \"prediction_value\": \"high\",\n  \"confidence_score\": 0.87,\n  \"prediction_ts\": \"2025-01-01T11:00:00Z\",\n  \"embedding\": [\n    0.44,\n    -0.33\n  ]\n}\n```","x":3080,"y":2180,"width":360,"height":520},
