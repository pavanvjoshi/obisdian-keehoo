		{"id":"13cc70d32d1cd368","type":"text","text":"```json\n{\n  \"storage_id\": \"string\",               // stable canonical id (e.g., provider:bucket:path or UUID)\n  \"provider\": \"string\",                 // e.g., minio, s3\n  \"storage_type\": \"enum\",               // object_store|file_system|block|db\n  \"bucket\": \"string\",\n  \"object_key\": \"string\",\n  \"uri\": \"string\",                      // e.g., minio://bucket/key or s3://bucket/key or https url\n  \"content_type\": \"string\",\n  \"file_extension\": \"string\",\n  \"size_bytes\": integer,\n  \"created_at\": \"timestamp\",\n  \"last_modified_at\": \"timestamp\",\n  \"asset_ids\": [\"string\"],              // reverse-link: which assets reference this storage object\n}\n \n```","x":-1120,"y":2180,"width":620,"height":440},
		{"id":"318a333636c725a4","type":"text","text":"```json\n{\n  \"record_id\": \"string\",\n  \"record_type\": \"enum\",  // \"structured\" | \"unstructured\" | \"streaming\"\n  \n  \"source\": {\n    \"system\": \"string\",\n    \"table\": \"string\",\n    \"operation\": \"enum\",\n    \"operation_timestamp\": \"timestamp\",\n    \"source_record_id\": \"string\"\n  },\n \n  \n  \"business_metadata\": {\n    \"asset_id\": \"string\",\n    \"asset_type\": \"enum\",  // \"image\" | \"video\" | \"document\" | \"spreadsheet\" | \"database_row\" | \"event\"\n    \"asset_subtype\": \"string\",\n    \"description\": \"string\",\n    \"category\": \"string\",\n    \"sequence_number\": \"integer\",\n    \"status\": \"enum\"\n  },\n  \n  \"technical_metadata\": {\n    \"common\": {\n      \"mime_type\": \"string\",\n      \"file_extension\": \"string\",\n      \"size_bytes\": \"integer\",\n      \"format\": \"string\",\n      \"schema_version\": \"string\"\n    },\n    \n    \"format_specific\": {\n    //respective field for different asset_type\n    }\n  },\n  \n  \"lifecycle\": {\n    \"created_at\": \"timestamp\",\n    \"created_by\": \"string\",\n    \"ingestion_details\": {\n      \"service\": \"string\",\n      \"version\": \"string\",\n      \"host\": \"string\"\n    },\n    \"processed_at\": \"timestamp\",\n    \"last_updated_at\": \"timestamp\",\n    \"partition_info\": {}\n  },\n  \n  \"audit_trail\": {\n    \"record_created_at\": \"timestamp\",\n    \"last_accessed_at\": \"timestamp\",\n    \"last_evaluated_at\": \"timestamp\",\n    \"record_version\": \"integer\",\n    \"related_records\": []\n  }\n}\n```","x":-460,"y":2180,"width":520,"height":920},
