			"type":"text",
			"text":"**API 3 for confirming dispatched?** \n1. yes\n\t1. Fulfillment\n2. no\n\t1. throw an error",
			"styleAttributes":{},
			"x":-660,
			"y":7840,
			"width":270,
			"height":280
		},
		{
			"id":"420907707f4758be",
			"type":"text",
			"text":"**API 5 for production started**\n\n1. production started and completed? \n\t1. continue the process \n2. failed\n\t1. Throw an error",
			"styleAttributes":{},
			"x":-1060,
			"y":7840,
			"width":300,
			"height":280
		},
		{
			"id":"84d81758042d4699",
			"type":"text",
			"text":"Create sales order ",
			"styleAttributes":{"textAlign":"center"},
			"x":-2190,
			"y":7460,
			"width":260,
			"height":60,
			"color":"2"
		},
		{
			"id":"fa3fa37b7ffcec4d",
			"type":"text",
			"text":"check item stock in stock application",
			"styleAttributes":{"textAlign":"center"},
			"x":-1810,
			"y":7460,
			"width":260,
			"height":60,
			"color":"2"
		},
		{
			"id":"0fa5401cfa961e1a",
			"type":"text",
			"text":"production started ",
			"styleAttributes":{"textAlign":"center"},
			"x":-1040,
			"y":7530,
			"width":260,
			"height":60,
			"color":"3"
		},
		{
			"id":"2cd984768c2271fb",
			"type":"text",
			"text":"**API 1 for checking stock availability**\n1. Stock available?\n\t1. Stock reserved\n\t2. Dispatched\n\t3. Fulfilled\n2. Not available?\n\t1. Production started \n\t2. Dispatched\n\t3. Fulfilled\n",
			"styleAttributes":{},
			"x":-1840,
			"y":7800,
			"width":320,
			"height":320
		},
		{"id":"4b1aac3f2629258e","type":"text","text":"**Make items**\nReturns production request ID\nSends status updates","x":11640,"y":1710,"width":250,"height":140,"color":"2"},
		{"id":"80d3e4ed6b5c7eca","type":"text","text":"**Check stock**\nResult: **none available**\nNothing to reserve","x":11140,"y":1460,"width":250,"height":140,"color":"4"},
		{"id":"68a6b5b9269a9d5f","type":"text","text":"**Ask Production**\nFull qty (10 of 10)\nPriority, needed-by date","x":11440,"y":1210,"width":250,"height":140,"color":"6"},
		{"id":"e7e63a269e4404a7","type":"text","text":"**Waiting for production / In production**\nItems held: 3 · In production: 7","x":11940,"y":2240,"width":250,"height":140,"color":"5"},
		{
			"id":"80802f68aaff8b4a",
			"type":"text",
			"text":"Stock reserved ",
			"styleAttributes":{"textAlign":"center"},
			"x":-1040,
			"y":7320,
			"width":260,
			"height":60,
			"color":"4"
		},
		{"id":"f1d08e050c84918a","type":"text","text":"**Save invoice**\nReturns Stock invoice ID","x":10740,"y":2740,"width":250,"height":140,"color":"4"},
		{"id":"8fc8c57b266d40b4","type":"text","text":"**Check stock**\nResult: **partial** (3 of 10)","x":11040,"y":2740,"width":250,"height":140,"color":"4"},
		{"id":"67bda7101b7364d3","type":"text","text":"**Save invoice**\nReturns Stock invoice ID","x":11260,"y":180,"width":250,"height":140,"color":"4"},
		{"id":"3431560d2454462e","type":"text","text":"**In production**\nShows Production's own status + expected date","x":11640,"y":960,"width":250,"height":140,"color":"5"},
		{"id":"ed0cca7e91165ad5","type":"text","text":"**3. Check and hold**\nBy invoice ID, per line\nResult: **all available** → reserve all","x":11660,"y":180,"width":250,"height":140,"color":"4"},
		{"id":"e6a95f4bf1e7507e","type":"text","text":"**Production finished**\nGoods sent to warehouse\nTells Stock and CRM","x":11940,"y":1710,"width":250,"height":140,"color":"2"},
		{"id":"0c4c465342f4e6f1","type":"text","text":"**4. Pick agent**\nInvoice ID + stock org ID\n→ pallet, rack, gate per line","x":11940,"y":-60,"width":250,"height":140,"color":"6"},
		{"id":"f4dcf66923abaa71","type":"text","text":"**Receive goods**\nAdd to stock, reserve for this order","x":12240,"y":1460,"width":250,"height":140,"color":"4"},
		{"id":"6f498944b1246281","type":"text","text":"**Create sales order + final tax invoice**\nStart workflow","x":10440,"y":2240,"width":250,"height":140,"color":"5"},
		{"id":"f8efbd727b8f81f1","type":"text","text":"**Save invoice**\nReturns Stock invoice ID","x":10740,"y":1460,"width":250,"height":140,"color":"4"},
		{"id":"4870361facb6ab6e","type":"text","text":"**Reserve the 3**\nHeld for this order, no other order can take them","x":11400,"y":2740,"width":250,"height":140,"color":"4"},
		{"id":"d4a3b95c3064960a","type":"text","text":"**Make 7 items**\nSends status updates","x":11940,"y":2990,"width":250,"height":140,"color":"2"},
		{"id":"e1b3bfe88494fc06","type":"text","text":"**Production finished**\nGoods to warehouse\nTells Stock and CRM","x":12240,"y":2990,"width":250,"height":140,"color":"2"},
		{"id":"76cabebdd3484846","type":"text","text":"**Production cannot deliver**\nor will be too late\nSends reason to CRM","x":10440,"y":4270,"width":250,"height":140,"color":"2"},
		{"id":"44154560de27c3d1","type":"text","text":"**Customer cancels**\nSalesperson records reason","x":10440,"y":3520,"width":250,"height":140,"color":"5"},
		{"id":"b6c3bf393d589dc9","type":"text","text":"**Cancel order**\nSales order ID, run ID, reason, cancelled by","x":10740,"y":3520,"width":250,"height":140,"color":"5"},
		{"id":"a3efb8e45810c891","type":"text","text":"**Cancel the run**\nEnds at Cancelled","x":11040,"y":3770,"width":250,"height":140,"color":"6"},
		{"id":"db79fb0053c24ff5","type":"text","text":"**Release held items**","x":11360,"y":4020,"width":250,"height":140,"color":"4"},
		{"id":"bb25d7ee94dfbc2d","type":"text","text":"**Order: Cancelled**\nReason shown\nCredit note if invoiced","x":11640,"y":3520,"width":250,"height":140,"color":"5"},
		{"id":"dd172e2a3e715ffa","type":"text","text":"**One flow, two ways**\nEvery step a system fills can also be filled by hand in the CRM, same fields.","x":10440,"y":4740,"width":280,"height":220,"color":"3"},
		{"id":"36180e5560712fba","type":"text","text":"**CRM-only customer**\nNo Stock or Production app. Every step by hand. CRM's own invoice ID used; pick agent skipped.","x":10760,"y":4740,"width":280,"height":220,"color":"3"},
		{"id":"73b779beadf01cab","type":"text","text":"**App is down**\nOnly the stuck step is filled by hand. Next step tries the system again.","x":11080,"y":4740,"width":280,"height":220,"color":"3"},
		{"id":"9c2c5da29df2797b","type":"text","text":"**Rules**\n1. Manual option appears only when the app is down or after a set wait (wait time: open)\n2. Marked 'not yet sent'; CRM resends automatically\n3. If refused → order flagged 'Needs checking'\n4. Records who entered it and when","x":11400,"y":4740,"width":340,"height":300,"color":"3"},
		{"id":"b1cd227dc5aea3d5","type":"text","text":"**Stop production**\nRecord reason","x":11340,"y":4270,"width":250,"height":140,"color":"2"},
		{"id":"64ceeced3a365b9a","type":"text","text":"**1. Create sales order**\nCustomer, products from master data, qty, rate\n→ sales order ID","x":10440,"y":-320,"width":250,"height":140,"color":"5"},
		{"id":"876aa81158d9a346","type":"text","text":"**Create sales order + final tax invoice**\nStart workflow","x":10440,"y":960,"width":250,"height":140,"color":"5"},
		{"id":"afe15fe59c8b9d96","type":"text","text":"**2. Create final tax invoice**\nCRM starts the workflow with sales order + invoice","x":10740,"y":-320,"width":250,"height":140,"color":"5"},
		{"id":"5ff08793acca7ac8","type":"text","text":"**Ask Production**\nMissing qty only (7)\nPriority, needed-by date","x":11640,"y":2490,"width":250,"height":140,"color":"6"},
		{"id":"d89af36cd4d08471","type":"text","text":"**Send invoice to Stock**\n(start of run)","x":11040,"y":-70,"width":250,"height":140,"color":"6"},
		{"id":"a09661572a35c444","type":"text","text":"**5. Check suggestion**\nWarehouse person confirms or changes the plan","x":12160,"y":180,"width":250,"height":140,"color":"4"},
		{"id":"5b186f55d7afd980","type":"text","text":"**Say continue**\nCRM tells the workflow to resume this order","x":12240,"y":960,"width":250,"height":140,"color":"5"},
		{"id":"dae9288cb5326f7b","type":"text","text":"**Live order stages**\nItems held → Pick plan ready → Picked → Shipped → Stock updated","x":12240,"y":-320,"width":250,"height":140,"color":"5"},
		{
			"id":"24e9b776441a9afb",
			"type":"text",
			"text":"## API 1 stock availability\n\n**Request:**\n```json\n{\n\t\"sales_id\": \"<UUID>\",\n\t\"\"\n}\n```\n\n**Response:**\n```json\n{\n\t\n}\n```",
			"styleAttributes":{},
			"x":960,
			"y":9770,
			"width":520,
			"height":720
		},
		{
			"id":"153378a3207b1fc9",
			"type":"text",
			"text":"## API 2 \n\n**Request:**\n```json\n{\n\t\n}\n```\n\n**Response:**\n```json\n{\n\t\n}\n```",
			"styleAttributes":{},
			"x":1540,
			"y":9770,
			"width":520,
			"height":720
		},
		{
			"id":"08a9931c99224d4f",
			"type":"text",
			"text":"## API 3\n\n**Request:**\n```json\n{\n\t\n}\n```\n\n**Response:**\n```json\n{\n\t\n}\n```",
			"styleAttributes":{},
			"x":2100,
			"y":9770,
			"width":520,
			"height":720
		},
		{
			"id":"3f3795982ab25dec",
			"type":"text",
			"text":"## API 4 \n\n**Request:**\n```json\n{\n\t\n}\n```\n\n**Response:**\n```json\n{\n\t\n}\n```",
			"styleAttributes":{},
			"x":2660,
			"y":9770,
			"width":520,
			"height":720
		},
		{
			"id":"fab04953834808a9",
			"type":"text",
			"text":"## API 5 - production post api call\n\n**Request:**\n```json\n# independent item call(bottle api call)\n{\n\t  \"item_id\":\"\",\n\t  \"sales_id\": \"\",\n\t  \"quantity\": \"\",\n\t  \"unit\": \"\",\n\t  \"priority\": \"\",\n\t  \"order_date\": \"\",\n\t  \"delivery_date\": \"\",\n\t  \"note\": \"\" \n}\n```\n\n**Response:**\n```json\n{\n\t\"sales_id\": \"\",\n\t\"item_id\": \"\",\n\t\"status\": \"completed/pending/failed\",\n\t\"completed_date\": \"\"\n}\n```",
			"styleAttributes":{},
			"x":3240,
			"y":9770,
			"width":520,
			"height":720
		},
		{
			"id":"658f159eb7320225",
			"type":"text",
			"text":"## manufacture production list\n\n1. fan - api call\n\t1. separate call\n2. bottle - api call\n\t1. separate call\n3. invoice copy? id?\n\t1. items\n\t2. unit\n\t3. quantity\n\t4. sales id\n\t5. priority\n\t6. start date and due date\n\t7. comment/note",
			"styleAttributes":{},
			"x":3840,
			"y":9920,
			"width":560,
			"height":420
		},
		{
			"id":"ebd87afd2987e8ed",
			"type":"text",
			"text":"## POST sales order - POST /{orgId}/sales/stock-out\n\n```\n{\n    \"so_number\": \"SO-2026-00421\",\n    \"so_date\": \"2026-08-20\",\n    \"customer_distributor\": \"NA\",\n    \"material_code\": \"NA\",\n    \"quantity\": NA,\n    \"uom\": \"NA\",\n    \"delivery_location\": \"NA\",\n    \"required_delivery_date\": \"NA\"\n  }\n```",
			"styleAttributes":{},
			"x":-5980,
			"y":6520,
			"width":1020,
			"height":600
		},
		{"id":"76de9a477e7985e5","type":"text","text":"**Receive 7**\nReserve with the held 3 → 10 ready","x":12540,"y":2740,"width":250,"height":140,"color":"4"},
		{"id":"9c30ebc2f46e54f5","type":"text","text":"**Pick agent**\nFor the full 10","x":12840,"y":2490,"width":250,"height":140,"color":"6"},
		{"id":"556bc6d286b72123","type":"text","text":"**Say continue**\nCRM resumes the run","x":12540,"y":2240,"width":250,"height":140,"color":"5"},
		{"id":"343103ace3ab1e0b","type":"text","text":"**Pick, dispatch, stock update**\nAll 10 in one shipment","x":13140,"y":2740,"width":250,"height":140,"color":"4"},
		{"id":"74ed0b8d1de3b4b7","type":"text","text":"**Order completed**","x":13440,"y":2240,"width":250,"height":140,"color":"5"},
		{
			"id":"83eb68aac7f88402",
			"type":"text",
			"text":"**API 2 for Stock reservation**\n\n1. Stock reserved? \n\t1. continue the process \n2. failed\n\t1. Throw an error",
			"styleAttributes":{},
			"x":-1060,
			"y":6920,
			"width":300,
			"height":270
		},
		{
			"id":"b3972ed9a92b13fa",
			"type":"text",
			"text":"**API  3 for confirming dispatched?** \n1. yes\n\t1. Fulfillment\n2. no\n\t1. throw an error",
			"styleAttributes":{},
			"x":-660,
			"y":6920,
			"width":270,
			"height":270
		},
		{
			"id":"ac280cc8e0c034ee",
			"type":"text",
			"text":"**API 4 for fulfillment complete**\n1. yes\n\t1. sales order success\n2. no \n\t1. sales order failed",
			"styleAttributes":{},
			"x":-265,
			"y":6930,
			"width":270,
			"height":250
		},
		{
			"id":"e7d2d5245ed552d8",
			"type":"text",
			"text":"1. production instance setup for kruise CRM\n2. new logo update\n3. Chatgpt fix integration\n4. salesflow integration \n5. website integration",
			"styleAttributes":{},
			"x":-6900,
			"y":3860,
			"width":380,
			"height":280
		},
		{
			"id":"3c049aec595944f6",
			"type":"text",
			"text":"1. if we need to setup CRM prod we need to first setup hub and platform to prod first. ",
			"styleAttributes":{},
			"x":-6200,
			"y":3860,
			"width":440,
			"height":240
		}
	],
