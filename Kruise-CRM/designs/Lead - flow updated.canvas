		{
			"id":"fd54bb6abe5beb1c",
			"type":"text",
			"text":"Contact Found and created",
			"styleAttributes":{},
			"x":-900,
			"y":-160,
			"width":260,
			"height":60
		},
		{
			"id":"987b18df746519d1",
			"type":"text",
			"text":"1. Prospect Profiling\n\t1. Send mail\n\t\t1. List of items\n\t\t2. Questions\n\t\t3. Contact id\n\t\t4. contact information \n\t\t\t1. Name\n\t\t\t2. email id\n\t\t\t3. Company name\n\t\t\t4. other required details\n**Wait for above contact lead response**\n2. Qualification review\n3. MQL",
			"styleAttributes":{},
			"x":-630,
			"y":440,
			"width":360,
			"height":420
		},
