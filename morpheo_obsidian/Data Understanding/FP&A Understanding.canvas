		{"id":"d90f6abf1343c6a2","type":"text","text":"Binding\n\nDQ\n\n10 DQs\n- 3  Tables ( Semantics)\n  \n  Natural language --> ontology --> actuals\n\n","x":528,"y":12524,"width":252,"height":316},
		{"id":"0bcd74ba215ffd57","type":"text","text":"**DQ**\n\n- Business Fields\n\t- Actual Fields\n\t- Confidence_Score","x":980,"y":12624,"width":250,"height":216},
