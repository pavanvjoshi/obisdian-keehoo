	"nodes":[
		{"id":"3387efbc8e1557df","x":-1260,"y":-3015,"width":1556,"height":1010,"type":"group","label":"table and column metadata"},
		{"id":"e066cbedf5db4412","x":-209,"y":-166,"width":609,"height":366,"type":"text","text":"```python\nimport os\n\nimport json\n\nfrom typing import Dict, List, Any\n\nfrom datetime import datetime\n\nfrom dotenv import load_dotenv\n\nfrom pymongo import MongoClient\n\nfrom langchain_openai import AzureChatOpenAI\n\nfrom langchain_core.tools import tool\n\nfrom langchain.agents import create_agent\n\nfrom utils.load_prompt import load_prompt\n\nfrom logger import logger\n\nfrom utils.helper_functions.est_datetime import get_est_now\n\n  \n\nload_dotenv()\n\n  \n\n# ============================================================\n\n# CONFIGURATION\n\n# ============================================================\n\nTABLE_METADATA_COLLECTION = \"table_metadata\"\n\nCOLUMN_METADATA_COLLECTION = \"column_metadata\"\n\nBUSINESS_CONTEXT_COLLECTION = \"business_context\"\n\n  \n\n# MongoDB Setup\n\nmongo_client = MongoClient(os.getenv(\"MONGODB_CONNECTION\"))\n\ndb = mongo_client[\"dev_demo\"]\n\n  \n  \n\n# ============================================================\n\n# TOOLS\n\n# ============================================================\n\n  \n\n@tool\n\ndef get_business_context() -> str:\n\n\"\"\"\n\nGet the business context for all tables.\n\nReturns the business context as a string.\n\n\"\"\"\n\nbusiness_context_doc = db[BUSINESS_CONTEXT_COLLECTION].find_one({})\n\nif business_context_doc and 'context' in business_context_doc:\n\nreturn business_context_doc['context']\n\nreturn \"\"\n\n  \n  \n\n@tool\n\ndef analyze_table_columns(table_id: str, source_id: str) -> str:\n\n\"\"\"\n\nAnalyze all columns for a specific table.\n\nReturns detailed statistics including Profile data, null counts, cardinality.\n\nArgs:\n\ntable_id: The unique identifier of the table to analyze\n\nsource_id: The unique identifier of the source\n\n\"\"\"\n\nlogger.info(f\"Analyzing columns for table: {table_id}, source: {source_id}\")\n\ntry:\n\ncolumns = list(db[COLUMN_METADATA_COLLECTION].find(\n\n{\"data.parent_id\": table_id, \"data.source_id\": source_id},\n\n{\"data.Profile\": 1, \"data.parent_id\": 1, \"data.source_id\": 1, \"_id\": 0}\n\n))\n\nif not columns:\n\nreturn json.dumps({\n\n\"table_id\": table_id,\n\n\"found\": False,\n\n\"total_columns\": 0\n\n}, indent=2)\n\ntable = db[TABLE_METADATA_COLLECTION].find_one(\n\n{\"data.id\": table_id, \"data.parent_id\": source_id},\n\n{\"data.be_name\": 1, \"data.label\": 1, \"data.parent_name\": 1, \"data.data_patterns\": 1, \"_id\": 0}\n\n)\n\ntable_name = table.get(\"data\", {}).get(\"be_name\", \"Unknown\") if table else \"Unknown\"\n\ntable_label = table.get(\"data\", {}).get(\"label\", \"\") if table else \"\"\n\nsource_name = table.get(\"data\", {}).get(\"parent_name\", \"\") if table else \"\"\n\nresult = {\n\n\"table_id\": table_id,\n\n\"table_name\": table_name,\n\n\"table_label\": table_label,\n\n\"source_name\": source_name,\n\n\"found\": True,\n\n\"total_columns\": len(columns),\n\n\"column_metadata\": columns\n\n}\n\nreturn json.dumps(result)\n\nexcept Exception as e:\n\nlogger.error(f\"Column analysis failed: {str(e)}\")\n\nreturn json.dumps({\n\n\"table_id\": table_id,\n\n\"found\": False,\n\n\"error\": str(e)\n\n}, indent=2)\n\n  \n  \n\n# ============================================================\n\n# SYSTEM PROMPT\n\n# ============================================================\n\n  \n\ntry:\n\nSYSTEM_PROMPT = load_prompt(\"migration_prompts/table_summary\")\n\nexcept FileNotFoundError:\n\nlogger.error(\"Prompt file not found. Using default system prompt.\")\n\nSYSTEM_PROMPT = \"You are a helpful assistant that analyzes database table metadata.\"\n\nexcept Exception as e:\n\nlogger.error(f\"Error loading prompt: {str(e)}\")\n\nSYSTEM_PROMPT = \"You are a helpful assistant that analyzes database table metadata.\"\n\n  \n  \n\n# ============================================================\n\n# HELPER FUNCTIONS\n\n# ============================================================\n\n  \n\ndef get_tables_for_source(source_id: str) -> List[Dict[str, str]]:\n\n\"\"\"\n\nRetrieve all tables for a given source.\n\nArgs:\n\nsource_id: The unique identifier of the source\n\nReturns:\n\nList of dictionaries containing table_id and table_name\n\n\"\"\"\n\ntables = list(db[TABLE_METADATA_COLLECTION].find(\n\n{\"data.parent_id\": source_id},\n\n{\"data.id\": 1, \"data.be_name\": 1, \"_id\": 0}\n\n))\n\nreturn [\n\n{\n\n\"table_id\": table[\"data\"][\"id\"],\n\n\"table_name\": table[\"data\"].get(\"be_name\", \"Unknown\")\n\n}\n\nfor table in tables\n\n]\n\n  \n  \n\ndef update_table_metadata(table_id: str, source_id: str, summary: str):\n\n\"\"\"\n\nUpdate table metadata with generated summary.\n\nArgs:\n\ntable_id: The unique identifier of the table\n\nsource_id: The unique identifier of the source\n\nsummary: The generated table context summary\n\nRaises:\n\nException if update fails\n\n\"\"\"\n\nresult = db[TABLE_METADATA_COLLECTION].update_one(\n\n{\"data.id\": table_id, \"data.parent_id\": source_id},\n\n{\"$set\": {\"data.summary\": summary}}\n\n)\n\n  \n\nif result.matched_count == 0:\n\nraise Exception(f\"Table not found: {table_id}\")\n\nif result.modified_count == 0:\n\nraise Exception(f\"Failed to update table: {table_id}\")\n\n  \n  \n\n# ============================================================\n\n# CORE FUNCTION\n\n# ============================================================\n\n  \n\ndef generate_table_context(table_id: str, source_id: str) -> Dict[str, Any]:\n\n\"\"\"\n\nGenerate table context documentation for a single table.\n\nArgs:\n\ntable_id: The unique identifier of the table\n\nsource_id: The unique identifier of the source\n\nReturns:\n\nDictionary with table context summary\n\n\"\"\"\n\nlogger.info(f\"Processing table: {table_id}\")\n\nstart_time = datetime.now()\n\ntry:\n\nENHANCED_SYSTEM_PROMPT = f\"\"\"{SYSTEM_PROMPT}\n\n  \n\n--------------------------------------------------\n\nCURRENT TASK PARAMETERS (USE THESE EXACT VALUES)\n\n--------------------------------------------------\n\ntable_id: {table_id}\n\nsource_id: {source_id}\n\n  \n\nYou MUST:\n\n1. First call get_business_context() to understand the organizational context\n\n2. Then call analyze_table_columns with EXACTLY these values:\n\n- table_id = \"{table_id}\"\n\n- source_id = \"{source_id}\"\n\n  \n\nDO NOT modify, infer, or substitute these values.\n\n\"\"\"\n\n  \n\nuser_query = \"Generate the table summary using the tools.\"\n\nllm = AzureChatOpenAI(\n\nazure_endpoint=os.getenv(\"OPENAI_API_URL\"),\n\napi_key=os.getenv(\"OPENAI_API_KEY\"),\n\nopenai_api_version=os.getenv(\"OPENAI_API_VERSION\"),\n\nmodel=os.getenv(\"INFERENCE_MODEL\"),\n\ntemperature=0\n\n)\n\n  \n  \n\nagent_executor = create_agent(\n\nmodel=llm,\n\ntools=[get_business_context, analyze_table_columns],\n\nsystem_prompt=ENHANCED_SYSTEM_PROMPT,\n\n)\n\nresult = agent_executor.invoke(\n\n{\"input\": user_query},\n\nconfig={\"recursion_limit\": 10}\n\n)\n\noutput = \"\"\n\nif isinstance(result, dict) and \"messages\" in result:\n\nmessages = result[\"messages\"]\n\nfor message in reversed(messages):\n\nif hasattr(message, 'content') and message.content:\n\nif not hasattr(message, 'tool_calls') or not message.tool_calls:\n\noutput = message.content\n\nbreak\n\nelse:\n\noutput = result.get(\"output\", str(result))\n\nend_time = datetime.now()\n\nduration = (end_time - start_time).total_seconds()\n\nreturn {\n\n\"status\": \"success\",\n\n\"table_id\": table_id,\n\n\"summary\": output,\n\n\"processing_time\": duration,\n\n\"timestamp\": datetime.utcnow().isoformat()\n\n}\n\nexcept Exception as e:\n\nlogger.error(f\"Error processing table {table_id}: {str(e)}\")\n\nimport traceback\n\nlogger.error(traceback.format_exc())\n\nreturn {\n\n\"status\": \"error\",\n\n\"table_id\": table_id,\n\n\"error\": str(e),\n\n\"traceback\": traceback.format_exc()\n\n}\n\n  \n  \n  \n\ndef process_single_source(source_id: str) -> Dict[str, Any]:\n\n\"\"\"\n\nProcess all tables for a single source.\n\nArgs:\n\nsource_id: The unique identifier of the source\n\nReturns:\n\nDictionary with processing results for this source\n\n\"\"\"\n\nlogger.info(\"\\n\" + \"=\"*80)\n\nlogger.info(f\"Processing Source: {source_id}\")\n\nlogger.info(\"=\"*80)\n\nsource_start = datetime.now()\n\n# Get all tables for source\n\ntables = get_tables_for_source(source_id)\n\nif not tables:\n\nlogger.warning(f\"No tables found for source: {source_id}\")\n\nreturn {\n\n\"status\": \"error\",\n\n\"message\": \"No tables found for source\",\n\n\"source_id\": source_id,\n\n\"total_tables\": 0,\n\n\"processed\": 0\n\n}\n\nlogger.info(f\"Found {len(tables)} tables to process\\n\")\n\nresults = {\n\n\"source_id\": source_id,\n\n\"total_tables\": len(tables),\n\n\"processed\": 0,\n\n\"tables\": []\n\n}\n\nfor idx, table in enumerate(tables, 1):\n\ntable_id = table[\"table_id\"]\n\ntable_name = table[\"table_name\"]\n\nlogger.info(f\"\\n[{idx}/{len(tables)}] Processing: {table_name} ({table_id})\")\n\nlogger.info(\"-\" * 80)\n\n# Generate context\n\nresult = generate_table_context(table_id=table_id, source_id=source_id)\n\nif result[\"status\"] != \"success\":\n\nlogger.error(f\"Failed to generate context: {result.get('error')}\")\n\nresults[\"status\"] = \"error\"\n\nresults[\"failed_table\"] = table_name\n\nresults[\"error\"] = result.get(\"error\")\n\nraise Exception(f\"Context generation failed for table {table_name}: {result.get('error')}\")\n\n# Save to MongoDB\n\ntry:\n\nupdate_table_metadata(\n\ntable_id=table_id,\n\nsource_id=source_id,\n\nsummary=result[\"summary\"]\n\n)\n\nlogger.info(f\"Saved to MongoDB\")\n\nexcept Exception as e:\n\nlogger.error(f\"Database update failed: {str(e)}\")\n\nresults[\"status\"] = \"error\"\n\nresults[\"failed_table\"] = table_name\n\nresults[\"error\"] = str(e)\n\nraise\n\nresults[\"processed\"] += 1\n\nresults[\"tables\"].append({\n\n\"table_id\": table_id,\n\n\"table_name\": table_name,\n\n\"processing_time\": result[\"processing_time\"]\n\n})\n\nlogger.info(f\"Completed in {result['processing_time']:.2f}s\")\n\nsource_end = datetime.now()\n\nsource_duration = (source_end - source_start).total_seconds()\n\nresults[\"status\"] = \"success\"\n\nresults[\"duration\"] = source_duration\n\nlogger.info(\"\\n\" + \"=\"*80)\n\nlogger.info(f\"Source Complete: {source_id}\")\n\nlogger.info(f\"Duration: {source_duration:.2f}s\")\n\nlogger.info(f\"Processed: {results['processed']}/{results['total_tables']}\")\n\nlogger.info(\"=\"*80)\n\nreturn results\n\n  \n  \n  \n\ndef generate_table_summary(source_id: List[str]) -> Dict[str, Any]:\n\n\"\"\"\n\nGenerate table context documentation for all tables across one or more sources.\n\nSaves each summary to MongoDB. Stops processing on any error.\n\nArgs:\n\nsource_id: List of source identifiers to process\n\nReturns:\n\nDictionary with batch processing results across all sources\n\n\"\"\"\n\nif not source_id:\n\nlogger.error(\"Empty source_id list provided\")\n\nreturn {\n\n\"status\": \"error\",\n\n\"message\": \"Empty source_id list provided\"\n\n}\n\nlogger.info(\"\\n\" + \"=\"*40)\n\nlogger.info(\"BATCH TABLE SUMMARY GENERATOR\")\n\nlogger.info(f\"Total Sources: {len(source_id)}\")\n\nlogger.info(\"=\"*40 + \"\\n\")\n\nbatch_start = get_est_now()\n\nall_results = {\n\n\"status\": \"success\",\n\n\"total_sources\": len(source_id),\n\n\"sources_processed\": 0,\n\n\"total_tables_processed\": 0,\n\n\"sources\": []\n\n}\n\nfor idx, source_id in enumerate(source_id, 1):\n\nlogger.info(f\"\\n{'='*40}\")\n\nlogger.info(f\"Source [{idx}/{len(source_id)}]: {source_id}\")\n\nlogger.info(f\"{'='*40}\")\n\ntry:\n\nsource_result = process_single_source(source_id)\n\nall_results[\"sources\"].append(source_result)\n\nall_results[\"sources_processed\"] += 1\n\nif source_result.get(\"status\") == \"success\":\n\nall_results[\"total_tables_processed\"] += source_result.get(\"processed\", 0)\n\nelse:\n\n# If any source fails, mark overall batch as error\n\nall_results[\"status\"] = \"partial_success\"\n\nlogger.warning(f\"Source {source_id} completed with errors\")\n\nexcept Exception as e:\n\nlogger.error(f\"Critical error processing source {source_id}: {str(e)}\")\n\nall_results[\"status\"] = \"error\"\n\nall_results[\"failed_source\"] = source_id\n\nall_results[\"error\"] = str(e)\n\n# Add failed source to results\n\nall_results[\"sources\"].append({\n\n\"source_id\": source_id,\n\n\"status\": \"error\",\n\n\"error\": str(e)\n\n})\n\nraise\n\nbatch_end = get_est_now()\n\ntotal_duration = (batch_end - batch_start).total_seconds()\n\nall_results[\"total_duration\"] = total_duration\n\nall_results[\"timestamp\"] = datetime.utcnow().isoformat()\n\nlogger.info(\"\\n\" + \"=\"*40)\n\nlogger.info(\"BATCH PROCESSING COMPLETE\")\n\nlogger.info(f\"Total Duration: {total_duration:.2f}s\")\n\nlogger.info(f\"Sources Processed: {all_results['sources_processed']}/{all_results['total_sources']}\")\n\nlogger.info(f\"Tables Processed: {all_results['total_tables_processed']}\")\n\nlogger.info(f\"Status: {all_results['status']}\")\n\nlogger.info(\"=\"*40 + \"\\n\")\n\nreturn all_results\n```\n"},
		{"id":"470531252752a157","x":-1440,"y":-157,"width":1082,"height":357,"type":"text","text":"```python\nimport os\n\nimport json\n\nfrom typing import List, Dict, Any\n\nfrom datetime import datetime\n\n  \n\nfrom dotenv import load_dotenv\n\nfrom pymongo import MongoClient\n\nfrom langchain_openai import AzureChatOpenAI\n\nfrom langchain.agents import create_agent\n\n  \n\nfrom utils.load_prompt import load_prompt\n\nfrom utils.helper_functions.est_datetime import get_est_now\n\nfrom logger import logger\n\n  \n\nload_dotenv()\n\n  \n\n# ============================================================\n\n# CONFIGURATION\n\n# ============================================================\n\n  \n\nTABLE_METADATA_COLLECTION = \"table_metadata\"\n\nBUSINESS_CONTEXT_COLLECTION = \"business_context\"\n\nSOURCE_METADATA_COLLECTION = \"source_metadata\"\n\n  \n\nmongo_client = MongoClient(os.getenv(\"MONGODB_CONNECTION\"))\n\ndb = mongo_client[\"dev_demo\"]\n\n  \n\n# ============================================================\n\n# DATA ACCESS HELPERS\n\n# ============================================================\n\n  \n\ndef get_business_context_text() -> str:\n\ndoc = db[BUSINESS_CONTEXT_COLLECTION].find_one({})\n\nreturn doc.get(\"context\", \"\") if doc else \"\"\n\n  \n  \n\ndef get_table_summaries_for_source(source_id: str) -> List[Dict[str, str]]:\n\ntables = list(\n\ndb[TABLE_METADATA_COLLECTION].find(\n\n{\"data.parent_id\": source_id, \"data.summary\": {\"$exists\": True}},\n\n{\"data.be_name\": 1, \"data.summary\": 1, \"_id\": 0},\n\n)\n\n)\n\n  \n\nreturn [\n\n{\n\n\"table_name\": t[\"data\"].get(\"be_name\", \"Unknown\"),\n\n\"summary\": t[\"data\"].get(\"summary\", \"\"),\n\n}\n\nfor t in tables\n\n]\n\n  \n  \n\ndef update_source_metadata(source_id: str, summary: str):\n\nresult = db[SOURCE_METADATA_COLLECTION].update_one(\n\n{\"data.id\": source_id},\n\n{\n\n\"$set\": {\n\n\"data.summary\": summary,\n\n\"data.updated_at\": get_est_now(),\n\n}\n\n},\n\nupsert=True,\n\n)\n\n  \n\nif result.matched_count == 0 and result.upserted_id is None:\n\nraise Exception(f\"Failed to update source metadata for {source_id}\")\n\n  \n\n# ============================================================\n\n# CORE SOURCE SUMMARY GENERATION\n\n# ============================================================\n\n  \n\ndef generate_source_context(source_id: str) -> Dict[str, Any]:\n\nlogger.info(f\"Generating source summary for source: {source_id}\")\n\nstart_time = get_est_now()\n\n  \n\ntable_summaries = get_table_summaries_for_source(source_id)\n\nif not table_summaries:\n\nraise Exception(f\"No table summaries found for source {source_id}\")\n\n  \n\nbusiness_context = get_business_context_text()\n\n  \n\ntry:\n\nSYSTEM_PROMPT = load_prompt(\"migration_prompts/source_summary\")\n\nexcept Exception:\n\nSYSTEM_PROMPT = (\n\n\"You are a senior data architect generating a source-level data summary.\"\n\n)\n\n  \n\nENHANCED_SYSTEM_PROMPT = f\"\"\"\n\n{SYSTEM_PROMPT}\n\n  \n\n--------------------------------------------------\n\nBUSINESS CONTEXT\n\n--------------------------------------------------\n\n{business_context}\n\n  \n\n--------------------------------------------------\n\nTABLE SUMMARIES (INPUT DATA)\n\n--------------------------------------------------\n\n{json.dumps(table_summaries, indent=2)}\n\n  \n\nINSTRUCTIONS:\n\n- Generate a single consolidated source-level summary\n\n- Synthesize table summaries; do NOT repeat them verbatim\n\n- Describe business domains, entities, and analytical use cases\n\n- Output plain text only\n\n\"\"\"\n\n  \n\nllm = AzureChatOpenAI(\n\nazure_endpoint=os.getenv(\"OPENAI_API_URL\"),\n\napi_key=os.getenv(\"OPENAI_API_KEY\"),\n\nopenai_api_version=os.getenv(\"OPENAI_API_VERSION\"),\n\nmodel=os.getenv(\"INFERENCE_MODEL\"),\n\ntemperature=0,\n\n)\n\n  \n\nagent_executor = create_agent(\n\nmodel=llm,\n\ntools=[],\n\nsystem_prompt=ENHANCED_SYSTEM_PROMPT,\n\n)\n\n  \n\nresult = agent_executor.invoke(\n\n{\"input\": \"Generate the source summary.\"},\n\nconfig={\"recursion_limit\": 5},\n\n)\n\n  \n\noutput = \"\"\n\nfor msg in reversed(result.get(\"messages\", [])):\n\nif hasattr(msg, \"content\") and msg.content:\n\noutput = msg.content\n\nbreak\n\n  \n\nduration = (get_est_now() - start_time).total_seconds()\n\n  \n\nreturn {\n\n\"status\": \"success\",\n\n\"source_id\": source_id,\n\n\"summary\": output,\n\n\"processing_time\": duration,\n\n\"timestamp\": get_est_now(),\n\n}\n\n  \n\n# ============================================================\n\n# SINGLE SOURCE PROCESSING\n\n# ============================================================\n\n  \n\ndef process_source_summary(source_id: str) -> Dict[str, Any]:\n\nlogger.info(\"\\n\" + \"=\" * 80)\n\nlogger.info(f\"Processing Source Summary: {source_id}\")\n\nlogger.info(\"=\" * 80)\n\n  \n\nstart_time = get_est_now()\n\n  \n\ntry:\n\nresult = generate_source_context(source_id)\n\n  \n\nupdate_source_metadata(\n\nsource_id=source_id,\n\nsummary=result[\"summary\"],\n\n)\n\n  \n\nduration = (get_est_now() - start_time).total_seconds()\n\n  \n\nlogger.info(\n\nf\"Source summary completed for {source_id} in {duration:.2f}s\"\n\n)\n\n  \n\nreturn {\n\n\"status\": \"success\",\n\n\"source_id\": source_id,\n\n\"processing_time\": duration,\n\n}\n\n  \n\nexcept Exception as e:\n\nlogger.error(\n\nf\"Source summary failed for {source_id}: {str(e)}\",\n\nexc_info=True,\n\n)\n\nraise\n\n  \n\n# ============================================================\n\n# BATCH SOURCE SUMMARY (MULTI-SOURCE)\n\n# ============================================================\n\n  \n\ndef generate_source_summary(source_ids: List[str]) -> Dict[str, Any]:\n\nif not source_ids:\n\nlogger.error(\"Empty source_id list provided\")\n\nreturn {\n\n\"status\": \"error\",\n\n\"message\": \"Empty source_id list provided\",\n\n}\n\n  \n\nlogger.info(\"\\n\" + \"=\" * 40)\n\nlogger.info(\"BATCH SOURCE SUMMARY GENERATOR\")\n\nlogger.info(f\"Total Sources: {len(source_ids)}\")\n\nlogger.info(\"=\" * 40 + \"\\n\")\n\n  \n\nbatch_start = get_est_now()\n\n  \n\nresults = {\n\n\"status\": \"success\",\n\n\"total_sources\": len(source_ids),\n\n\"sources_processed\": 0,\n\n\"sources\": [],\n\n}\n\n  \n\nfor idx, source_id in enumerate(source_ids, 1):\n\nlogger.info(f\"\\n{'=' * 40}\")\n\nlogger.info(f\"Source [{idx}/{len(source_ids)}]: {source_id}\")\n\nlogger.info(f\"{'=' * 40}\")\n\n  \n\ntry:\n\nsource_result = process_source_summary(source_id)\n\n  \n\nresults[\"sources\"].append(source_result)\n\nresults[\"sources_processed\"] += 1\n\n  \n\nexcept Exception as e:\n\nlogger.error(f\"Critical error processing source {source_id}: {str(e)}\")\n\nresults[\"status\"] = \"error\"\n\nresults[\"failed_source\"] = source_id\n\nresults[\"error\"] = str(e)\n\n  \n\nresults[\"sources\"].append(\n\n{\n\n\"source_id\": source_id,\n\n\"status\": \"error\",\n\n\"error\": str(e),\n\n}\n\n)\n\nraise\n\n  \n\nbatch_end = get_est_now()\n\nresults[\"total_duration\"] = (batch_end - batch_start).total_seconds()\n\nresults[\"timestamp\"] = get_est_now()\n\n  \n\nlogger.info(\"\\n\" + \"=\" * 40)\n\nlogger.info(\"BATCH SOURCE SUMMARY COMPLETE\")\n\nlogger.info(f\"Duration: {results['total_duration']:.2f}s\")\n\nlogger.info(\n\nf\"Processed: {results['sources_processed']}/{results['total_sources']}\"\n\n)\n\nlogger.info(\"=\" * 40 + \"\\n\")\n\n  \n\nreturn results\n```\n"},
		{"id":"6c91f34937531fe4","x":-320,"y":-2889,"width":596,"height":379,"type":"text","text":"```json\n/** \n* Paste one or more documents here\n*/\n{\n  \"data\": {\n    \"id\": \"fd2cde1a41cb1bb5b8b8c2f6713ad3b3\",\n    \"label\": \"department\",\n    \"be_name\": \"department\",\n    \"type\": \"column\",\n    \"file_type\": \"structured\",\n    \"data_type\": \"string\",\n    \"nullable\": true,\n    \"sensitivity_classification\": \"NONE\",\n    \"parent_type\": \"table\",\n    \"parent_id\": \"1071935d673c1b203790632b7ad984c4\",\n    \"parent_name\": \"sample_gl_export_cleansed_sheet1\",\n    \"source_id\": \"1aa42713-8db2-442e-8a49-c805ced90b8a\",\n    \"source_name\": \"test_919_09\",\n    \"description\": \"department in sample_gl_export_cleansed_sheet1 represents the department associated with the General Ledger entry for the Financial Planning & Analysis entity in the Finance domain and is used for departmental financial reporting.\",\n    \"loaded\": true\n  },\n  \"created_at\": {\n    \"$date\": \"2025-12-02T16:03:25.970Z\"\n  },\n  \"created_by\": \"user\",\n  \"embedding_input\": \"[IDENTITY] department.sample_gl_export_cleansed_sheet1.test_919_09 | department from Sample General Ledger Export Cleansed Sheet 1 from test_919_09 source | Department in General Ledger | FinancialPlanningAndAnalysis Finance | aka: dept, business_unit | [ONTOLOGY] Entity: General Ledger | Domain: Finance | Role: attribute | [SEMANTICS] Department associated with the financial transaction for reporting and analysis | Values: predefined department names | Rules: must exist in department master; required for all entries | [TECHNICAL] VARCHAR(50) NOT NULL | Format: alphabetic characters and spaces\",\n  \"human_feedback\": [\n    {\n      \"user\": \"\",\n      \"comment\": \"\",\n      \"timestamp\": \"\"\n    }\n  ],\n  \"last_updated_by\": \"Meta Intelligence\",\n  \"sample_values\": [\n    \"REDACTED\",\n    \"REDACTED\",\n    \"REDACTED\",\n    \"REDACTED\",\n    \"REDACTED\",\n    \"REDACTED\",\n    \"REDACTED\",\n    \"REDACTED\",\n    \"REDACTED\",\n    \"REDACTED\"\n  ],\n  \"status\": \"active\",\n  \"tags\": [\n    \"department\",\n    \"finance\",\n    \"reporting\"\n  ],\n  \"updated_at\": {\n    \"$date\": \"2025-12-29T08:02:06.279Z\"\n  },\n  \"input_reference\": {\n    \"file_path\": \"\",\n    \"context\": \"\",\n    \"label\": \"\",\n    \"type\": \"Structured\"\n  }\n}\n```"},
		{"id":"6b7ba7478718da4a","x":-1240,"y":-2995,"width":700,"height":970,"type":"text","text":"```json\n/** \n* Paste one or more documents here\n*/\n{\n  \"data\": {\n    \"id\": \"c5efdac9143df8e942ce401662b444a5\",\n    \"icon\": \"\",\n    \"label\": \"Chart of Accounts Hierarchy Format\",\n    \"be_name\": \"coa_hierarchy_format_in\",\n    \"technical_name\": \"coa_hierarchy_format_in\",\n    \"type\": \"table\",\n    \"parent_type\": \"source\",\n    \"parent_id\": \"4e45793d-cfd0-421f-9f8a-92ce0bfaaee4\",\n    \"parent_name\": \"dec23_sharepoint_point\",\n    \"file_type\": \"structured\",\n    \"count\": 8,\n    \"description\": \"Chart of Accounts Hierarchy Format in Financial Planning & Analysis provides a structured representation of financial account classifications and relationships essential for accurate financial reporting.\",\n    \"columns\": [\n      \"dim\",\n      \"member_name\",\n      \"member_alias\",\n      \"parent_name\",\n      \"operator\",\n      \"cmd\",\n      \"member_id\",\n      \"external_id\"\n    ],\n    \"business_entity\": \"Chart of Accounts Hierarchy\",\n    \"bronze_path\": \"abfss://dev-vena-bronze@devmorpheodatalake.dfs.core.windows.net/bronze_data/dec23_sharepoint_point/coa_hierarchy_format_in\",\n    \"loaded\": true,\n    \"source_path\": \"abfss://dev-vena-landing@devmorpheodatalake.dfs.core.windows.net/dec23_sharepoint_point/RAW_d_test_folder_do_not_change_d_provided_samples_f_coa_hierarchy_format_xlsx/COA Hierarchy Format.xlsx\",\n    \"data_patterns\": \"\",\n    \"Profile\": {\n      \"total_columns\": 8,\n      \"total_rows\": 455\n    },\n  },\n  \"status\": \"active\",\n  \"created_at\": {\n    \"$date\": \"2025-12-23T12:25:44.326Z\"\n  },\n  \"created_by\": \"user\",\n  \"embedding_input\": \"[IDENTITY] coa_hierarchy_format_in.dec23_sharepoint_point | Chart of Accounts Hierarchy Format from dec23_sharepoint_point source | Chart of Accounts in Financial Planning & Analysis | SharePoint Finance | aka: coa_hierarchy, account_structure, financial_account_hierarchy | [ONTOLOGY] Entity: Financial Account | Parent: None | Children: None | Related: General Ledger via member_id; Trial Balance via member_id | Domain: Finance | Role: master | [SEMANTICS] Master table for defining the hierarchy and attributes of financial accounts in the Chart of Accounts | Purpose: support account classification, relationship establishment, and financial reporting | Rules: member_id must be unique; member_name must exist in account categories; parent_name must reference valid parent accounts | Dependencies: if operator='sum' then total must be calculated; if cmd='add' then member must be included in calculations | Standards: Financial reporting standards | [TECHNICAL] master | Columns: 8 | PK: member_id | FK: account_number→chart_of_accounts.account_number | Indexes: idx_member_id, idx_parent_name | Format: structured data\",\n  \"foreign_keys\": [\n    \"account_number\"\n  ],\n  \"foreign_keys_referencing_tables\": [\n    {\n      \"to_table\": \"General Ledger Sheet1\",\n      \"linking_column\": \"account_number\",\n      \"relation_description\": \"The General Ledger entries must reference valid accounts defined in the Chart of Accounts Hierarchy Format for accurate financial reporting.\",\n      \"relationship\": \"many-to-one\"\n    },\n    {\n      \"to_table\": \"Trial Balance Sheet1\",\n      \"linking_column\": \"account_number\",\n      \"relation_description\": \"The Trial Balance must reference valid accounts from the Chart of Accounts Hierarchy Format to ensure accurate tracking of financial activities.\",\n      \"relationship\": \"many-to-one\"\n    }\n  ],\n  \"human_feedback\": [\n    {\n      \"user\": \"\",\n      \"comment\": \"\",\n      \"timestamp\": \"\"\n    }\n  ],\n  \"last_updated_by\": \"Meta Intelligence\",\n  \"primary_keys\": [\n    \"member_id\"\n  ],\n  \"primary_keys_referencing_tables\": [\n    {\n      \"to_table\": \"Trial Balance Sheet1\",\n      \"from_column\": \"member_id\",\n      \"linking_column\": \"member_id\",\n      \"relation_description\": \"Referenced by Trial Balance Sheet1: The Trial Balance references the Chart of Accounts to classify financial activities and ensure proper account categorization.\",\n      \"relationship\": \"one-to-many\"\n    }\n  ],\n  \"tags\": [\n    \"Chart of Accounts\",\n    \"Financial Planning\",\n    \"Data Quality\"\n  ],\n  \"updated_at\": {\n    \"$date\": \"2025-12-23T12:29:11.551Z\"\n  },\n  \"input_reference\": {\n    \"file_path\": \"\",\n    \"context\": \"\",\n    \"label\": \"\",\n    \"type\": \"Structured\"\n  },\n}\n```"},
		{"id":"72a56002e842946e","x":880,"y":-1320,"width":662,"height":1001,"type":"text","text":"## Table Summary :\n\n### Input:\n1. Table Information\n  2. Name - (label)\n  3. Column Names - List (columns)\n  4. Table Profile (Profile)\n    5. Column count - integer\n    6. Rows count\n  7. Data Patterns (data_patterns)\n  8. PK \n  9. FK \n  10. PKRT\n  11. FKRT\n  12. Current Embedding input as description of table - This will have brief about all the things, give correct wieghtage.\n13. Column Info\n  14. Column  names\n  15. Column Description\n  16. Sample values\n  17. Profile Object\n18. Business context\n19. External context - FMO\n\nProcessing - LLM call with System prompt seeking for summary accordingly.\n\nOutput - Should be stored in a variable named \"summary\" under same document of table metadata. \n\n**Not to be done** :\n- If in sample values \"nan\" pops in avoid it.\n- Currently do not consider the data type field. \n**To be added** :\n- Relationships across tables\n- Missing fields which was supposed to be there as per industry standards but did miss out in current meta. \n  - Example - Column named credit or debit should have been there but only amount is matching at-most with similar description.\n\n\n "},
		{"id":"e868190398c4cc07","x":2400,"y":-1480,"width":1040,"height":1600,"type":"text","text":"## What this table is\n\nThe Chart of Accounts Hierarchy Format serves as a foundational structure for the financial planning and analysis domain within the organization. Each row in this table represents either a summary (roll-up) node, such as \"Balance Sheet\" or \"Assets,\" or a leaf account, which primarily consists of four-digit account codes, alongside a few unique identifiers like \"1092.\" This hierarchical representation is crucial for categorizing financial activities into consistent, reportable categories, thereby supporting effective planning, budgeting, and forecasting.\n\n**Size/Scope:**\nThe table contains a total of 455 rows, comprising 66 summary nodes and 389 leaf accounts. This distribution indicates a well-defined structure that allows for detailed financial tracking and reporting.\n\n## How each column works\n\n- **dim**: Represents the dimension type for financial accounts, categorizing them within the Chart of Accounts. It consistently holds the value \"Account\" across all entries, indicating a lack of variability.\n  \n- **member_name**: This column contains the names of financial account members, serving as identifiers for account categories. It features a diverse set of values, including both numeric account codes (e.g., \"1001\") and descriptive names (e.g., \"Assets\"), with a high entropy of 8.83, suggesting a rich variety of account names.\n\n- **member_alias**: Provides alternative identifiers for financial accounts, facilitating cross-referencing. While it has 341 unique entries, there are 76 instances of \"nan,\" indicating potential gaps in naming conventions that could be improved for clarity.\n\n- **parent_name**: Establishes hierarchical relationships by indicating the parent accounts for each entry. With 65 unique parent names, this column supports the structural integrity of the financial reporting framework.\n\n- **operator**: Indicates the mathematical operators used for account calculations, predominantly showing addition (\"+\") with only a few instances of subtraction (\"-\"). This suggests a strong tendency towards aggregation in financial calculations.\n\n- **cmd**: This column is intended to define operations within financial data structures but contains only \"nan\" values, indicating a lack of operational commands.\n\n- **member_id**: Serves as the unique identifier for each account member, ensuring traceability. However, it currently lacks variability, as it only contains \"nan\" values, which is a significant gap in the data.\n\n- **external_id**: Represents external reference identifiers for linking to external financial systems, but similarly to member_id, it contains only \"nan\" values, indicating a lack of usable external references.\n\n## The hierarchy structure\n\nAt the top level, the hierarchy begins with the \"Chart of Accounts,\" branching into various categories such as \"Balance Sheet\" and \"Net Income.\" This structure allows for a clear representation of financial relationships and supports the aggregation of financial data for reporting purposes.\n\n## How it connects to related data/other tables\n\nThe Chart of Accounts Hierarchy Format is intricately linked to several other tables within the financial ecosystem. It serves as a master reference for the Trial Balance and General Ledger, ensuring that all financial activities are categorized correctly. The primary key, **member_id**, is referenced by the Trial Balance Sheet1 and other related tables, establishing a one-to-many relationship where each account can be linked to multiple transactions. Additionally, the foreign key **account_number** connects to the General Ledger and Trial Balance, reinforcing the need for accurate account categorization.\n\n## Data patterns briefing\n\nThe data patterns reveal a well-structured representation of financial account classifications characterized by a self-referencing hierarchy. The dataset comprises 455 nodes, with approximately 70% being leaf nodes, indicating a depth level that allows for detailed financial tracking. The naming convention is straightforward, with no complex modifiers or suffixes present, suggesting a systematic approach to account numbering. However, the presence of \"nan\" values in the member_alias, member_id, and external_id columns highlights areas for improvement in data completeness and clarity.\n\n## Quality of the data\n\nThe quality of the data presents both strengths and weaknesses. While the structure is robust and the hierarchical relationships are clear, significant gaps exist in the member_id and external_id columns, which contain only \"nan\" values. This lack of usable identifiers undermines the traceability and integrity of the financial accounts. Additionally, the presence of \"nan\" in the member_alias column suggests inconsistencies in naming conventions that could hinder effective cross-referencing. Overall, while the dataset exhibits a strong structural foundation, addressing these gaps is essential for enhancing data quality and ensuring reliable financial reporting."},
		{"id":"34b30332f9d91fb4","x":3520,"y":-1480,"width":1000,"height":980,"type":"text","text":"The analysis of the Chart of Accounts Hierarchy Format reveals a well-structured representation of financial account classifications, characterized by a self-referencing hierarchy that showcases a clear parent-child relationship. The root node of this hierarchy is the \"Chart of Accounts,\" from which various account categories branch out. The dataset comprises a total of 455 nodes, with a significant number of leaf nodes, indicating that a substantial portion of these accounts are terminal in the hierarchy. Specifically, the leaf nodes account for approximately 70% of the total, highlighting a depth level that allows for detailed financial tracking. The hierarchy exhibits a balanced distribution of parent and leaf nodes, with 65 distinct parent categories identified, such as \"Bank,\" \"Other Current Liability,\" and \"Stadium & Facilities,\" which collectively contribute to the structural integrity of the financial reporting framework.\n\nIn terms of account range categorization, the dataset does not explicitly categorize accounts into traditional ranges like 4xxx for Revenue or 5xxx for Expense. However, the presence of specific account identifiers, such as \"1001\" to \"1005\" associated with \"US Bank,\" suggests a systematic approach to account numbering. Notably, there are 76 instances of the member alias being \"nan,\" indicating potential gaps in the naming conventions that could be addressed for better clarity. The analysis also identifies special account patterns, with no explicit suffixes like \"x99\" or keywords such as \"Contra\" or \"Allocation\" present in the dataset, suggesting a straightforward naming convention without complex modifiers.\n\nFrom a semantic perspective, the dataset primarily utilizes the \"member_name\" column as the display name, while \"member_id\" serves as the technical identifier. The distinct counts reveal that there are 455 unique member names, but only one distinct member ID, indicating a potential area for improvement in the identification system. The controlled vocabulary within the parent categories shows that \"Bank\" appears 42 times, \"Other Current Liability\" 32 times, and \"Stadium & Facilities\" 28 times, representing 9.2%, 7%, and 6.1% of the total, respectively. This concentration suggests a strong reliance on a few key categories for financial reporting.\n\nBehaviorally, the dataset exhibits a predominance of directional operators, with 452 instances of the addition operator (+) compared to only 3 instances of subtraction (-), indicating a strong tendency towards aggregation in financial calculations. This behavior aligns with the expectation that most accounts are additive, particularly in the context of assets and revenues. The analysis also highlights that only leaf nodes are transactional, with 70% of the total nodes being classified as such, reinforcing the notion that these accounts are primarily used for recording financial transactions.\n\nRelationally, the dataset indicates a lack of explicit foreign key relationships to other tables, such as General Ledger (GL) or Trial Balance (TB), which could enhance the relational integrity of the financial data. The cardinality patterns suggest a one-to-many relationship within the hierarchy, where each parent can have multiple child accounts, but each child is linked to a single parent. The table serves as a dimension in the financial reporting framework, acting as master data that provides essential reference points for financial analysis.\n\nIn conclusion, the analysis of the Chart of Accounts Hierarchy Format reveals a robust structure with clear hierarchical relationships, a straightforward naming convention, and a strong tendency towards additive behavior in financial calculations. The presence of distinct parent categories and a high percentage of leaf nodes further supports the integrity of the dataset. Given the strong signals identified across structural, semantic, behavioral, and relational characteristics, the confidence assessment for this analysis is high, rated at 0.9 or above."},
		{"id":"b7afac670c914d3f","x":10960,"y":-2290,"width":660,"height":2120,"type":"text","text":"## What this table is\n\nThe **Chart of Accounts Hierarchy Format** serves as a master table that defines the hierarchy and attributes of financial accounts within the Financial Planning & Analysis (FP&A) domain. It is crucial for supporting account classification, establishing relationships, and facilitating financial reporting. This table is structured to ensure that every account is unique, correctly typed (asset, liability, equity, revenue, expense), and aligned with reporting hierarchies.\n\n**Size/Scope:**\n- Total rows: 455\n- Summary nodes: 65 (distinct parent categories)\n- Leaf accounts/members: Approximately 318 (70% of total nodes)\n\n## Column definitions\n\n- **dim**: Represents the dimension type for financial accounts, categorizing account types within the Chart of Accounts.\n- **member_name**: Contains the names of financial account members, used for identifying account categories.\n- **member_alias**: Provides alternative identifiers for financial account members, facilitating cross-referencing of account names.\n- **parent_name**: Indicates the hierarchical parent names for financial accounts, establishing account relationships.\n- **operator**: Specifies the mathematical operators used for account calculations, defining relationships within the financial data.\n- **cmd**: Represents commands associated with the Chart of Accounts, defining operations within financial data structures (currently contains only 'nan').\n- **member_id**: Serves as the unique identifier for each member in the Chart of Accounts, ensuring uniqueness and traceability.\n- **external_id**: Represents external reference identifiers for members, linking to external financial systems (currently contains only 'nan').\n\n## Missing/unpopulated fields & gap analysis\n\n**Unpopulated fields present in the file:**\n- **cmd**: Contains only 'nan', indicating a lack of meaningful command data.\n- **member_id**: Contains only 'nan', suggesting a potential issue with the identification system.\n\n**Expected industry-standard fields missing entirely:**\n- While the table adheres to basic structural requirements, the absence of meaningful values in **cmd** and **member_id** limits its utility for operational commands and unique identification, which could impact reporting and reconciliation processes.\n\n## The structure it defines\n\nThe table exhibits a self-referencing hierarchy with a clear parent-child relationship:\n- **Top-level nodes**: \"Chart of Accounts\"\n- **Major branches**:\n  - **Balance Sheet** (leaf count: 5; codes: 1001-1005)\n  - **Assets** (leaf count: 4; codes: 1001-1004)\n  - **Current Assets** (leaf count: 1; code: 1002)\n  - **Bank** (leaf count: 1; code: 1092)\n  \nThe structure is primarily flat with hierarchical attributes, where each parent can have multiple child accounts, but each child is linked to a single parent.\n\n## How it connects to related data/other tables\n\n- **Primary key relationships (PKRT)**: The **member_id** serves as the primary key, linking to the **Trial Balance** and other related tables, establishing a one-to-many relationship.\n- **Foreign key relationships (FKRT)**: The **account_number** is referenced by the **General Ledger** and **Trial Balance**, ensuring that all entries correspond to valid accounts defined in the Chart of Accounts.\n\n## Data patterns briefing\n\n- **Code/ID ranges**: The dataset does not categorize accounts into traditional ranges but includes specific identifiers like \"1001\" to \"1005\" for \"US Bank.\"\n- **Naming conventions**: The naming convention is straightforward, with no complex modifiers or suffixes observed.\n- **Operator/flag usage**: Predominantly uses the addition operator (+) with 452 instances compared to only 3 instances of subtraction (-), indicating a focus on aggregation.\n- **Value distributions**: The dataset shows a concentration of records in specific categories, with 42 instances of \"Bank\" and 32 of \"Other Current Liability.\"\n- **Grouping patterns**: Records cluster around key parent categories, reinforcing the hierarchical structure.\n\n## Quality of the data\n\n- **Completeness**: All fields are populated, but **cmd** and **member_id** contain only 'nan', indicating a lack of meaningful data.\n- **Consistency**: The naming patterns and operator usage are consistent, with no deviations observed.\n- **Gaps**: The absence of meaningful values in **cmd** and **member_id** represents a significant gap that could affect operational integrity.\n- **Integrity issues**: No duplicates or invalid references were identified, but the reliance on 'nan' for critical identifiers raises concerns about data integrity.\n\nOverall, the **Chart of Accounts Hierarchy Format** is a well-structured table that plays a vital role in financial reporting, though improvements in the identification system and command data would enhance its functionality and reliability."},
		{"id":"e47113ca995f7911","x":11880,"y":-2510,"width":640,"height":1260,"type":"text","text":"## What this table is\n\nThe **General Ledger Sheet1** serves as a critical repository for detailed financial transactions within the Financial Planning & Analysis domain. This table captures essential data related to various financial activities, ensuring that all entries are accurately recorded and traceable for reporting and analysis purposes.\n\n**Size/Scope:**\n- Total rows: **24,675**\n- Unique account numbers: **307**\n- Notable concentration in revenue accounts (4xxx range): **1,000 entries**\n\n## Column definitions\n\n- **account_description**: Represents the detailed description of an account for the General Ledger entity, used for financial reporting and analysis.\n- **account_number**: The unique identifier for an account in the General Ledger, essential for transaction tracking and financial reporting.\n- **account_type**: Classifies the account (e.g., asset, liability, equity) for financial categorization and reporting.\n- **amount**: The monetary value associated with a transaction, critical for financial reporting and analysis.\n- **amount_foreign_currency**: The monetary value of a transaction in foreign currency, used for currency conversion analysis.\n- **date**: The transaction date for General Ledger entries, vital for validating accounting integrity and generating financial statements.\n- **department**: The department associated with General Ledger entries, used for departmental reporting and analysis.\n- **department_id**: The unique identifier for departments associated with General Ledger entries, ensuring referential integrity in reporting.\n- **document_number**: The unique identifier for documents associated with General Ledger entries, used for traceability and audit readiness.\n- **exchange_rate**: The currency exchange rate applied to transactions, necessary for converting foreign currency amounts to the base currency.\n- **invoice_number**: The unique identifier for journal entries, used for tracking and referencing financial transactions.\n- **item**: Specific goods or services associated with a financial transaction, used for detailed transaction analysis.\n- **line_id**: The sequential identifier for each line item in a financial transaction, used for organizing transaction details.\n- **line_unique_key**: The unique identifier for each line entry in a financial transaction, ensuring data integrity and traceability.\n- **memo**: Additional notes or comments related to a financial transaction, providing context and details.\n- **memo_main**: Additional notes related to a General Ledger entry, used for providing context or explanations.\n- **name**: The name associated with a General Ledger entry, used for identifying the transaction or account holder.\n- **period**: The accounting period for a General Ledger entry, used for time-based financial reporting and analysis.\n- **subsidiary**: The identifier for a subsidiary associated with a General Ledger entry, used for tracking financial data across business units.\n- **subsidiary_name**: The full name of a subsidiary associated with a General Ledger entry, providing clarity on the business unit involved.\n- **subsidiary_currency**: The currency used by the subsidiary for financial transactions, ensuring accurate reporting.\n- **type**: The type of journal entry recorded in the General Ledger, used for categorizing financial transactions.\n- **event**: The event associated with the journal entry, used for tracking significant financial occurrences.\n- **event_external_id**: The external identifier for the event linked to the journal entry, used for cross-referencing with external systems.\n- **opponent**: The counterpart involved in the financial transaction, used for identifying transaction parties.\n- **day**: The specific day of the transaction, used for date-based financial reporting and analysis.\n- **activity**: The type of financial activity associated with a transaction, used for categorizing financial events.\n- **activity_external_id**: An external identifier for the financial activity linked to a transaction, used for cross-referencing.\n- **ramp_receipt_url**: The URL link to the receipt or documentation for a transaction, used for audit and traceability purposes.\n\n## Missing/unpopulated fields & gap analysis\n\n**Unpopulated fields present in the file:**\n- **account_description**: Contains only \"nan\" for all entries, indicating a lack of detailed descriptions.\n- **department**: Contains \"REDACTED\" for all entries, limiting visibility into departmental data.\n- **memo**: Contains \"REDACTED\" for all entries, restricting contextual information for transactions.\n- **memo_main**: Contains \"REDACTED\" for all entries, limiting additional context for General Ledger entries.\n- **item**: Contains \"nan\" for all entries, indicating a lack of specific goods or services associated with transactions.\n- **opponent**: Contains \"nan\" for all entries, limiting identification of transaction parties.\n\n**Expected industry-standard fields missing entirely:**\n- No critical fields appear to be missing, but the lack of detailed descriptions and specific identifiers (e.g., item, opponent) may impact the quality of financial analysis and reporting.\n\n## The structure it defines\n\nThe **General Ledger Sheet1** presents a flat structure with transactional data, where each row represents a unique financial transaction identified by the **line_unique_key**. The table captures various attributes related to each transaction, including amounts, dates, and associated accounts.\n\n**Key relationships:**\n- The **line_unique_key** serves as the primary key, ensuring each entry is distinct.\n- The **account_number** and **event_external_id** serve as foreign keys, linking to other tables such as the Chart of Accounts and Trial Balance, enhancing relational integrity.\n\n## How it connects to related data/other tables\n\n- **Primary key relationships (PKRT)**: The **line_unique_key** is referenced by multiple tables, including the Chart of Accounts and Trial Balance, ensuring accurate financial reporting.\n- **Foreign key relationships (FKRT)**: The **account_number** and **event_id** link to the Trial Balance, ensuring that General Ledger entries are validated against recognized accounts.\n\n## Data patterns briefing\n\n- **Code/ID ranges**: The dataset includes **305 distinct account numbers**, with a notable concentration in the **4xxx range** (revenue accounts).\n- **Naming conventions**: The **account_type** is predominantly \"REDACTED,\" limiting visibility into account classifications.\n- **Value distributions**: Positive amounts indicate revenue, while negative amounts represent expenses, with common values such as **1,000.0** (revenue) and **-1,000.0** (expense).\n- **Grouping patterns**: The dataset exhibits a clear distinction between income and outflows, with multi-range rules ensuring accurate categorization.\n\n## Quality of the data\n\n- **Completeness**: The dataset is complete in terms of row count, but many fields contain \"nan\" or \"REDACTED\" values, indicating significant gaps in descriptive data.\n- **Consistency**: The dataset shows uniformity in naming patterns, but the prevalence of \"nan\" values raises concerns about data quality.\n- **Gaps**: Missing detailed descriptions and identifiers limit the dataset's usability for comprehensive financial analysis.\n- **Integrity issues**: The high frequency of \"nan\" values suggests potential integrity issues that could affect confidence in financial reporting.\n\nOverall, while the **General Ledger Sheet1** provides a structured view of financial transactions, the reliance on \"nan\" and \"REDACTED\" values indicates a need for improved data quality and completeness to enhance its effectiveness for financial planning and analysis."},
		{"id":"62f6f608096d4756","x":12707,"y":-2630,"width":753,"height":1220,"type":"text","text":"## What this table is\n\nThe **Trial Balance Sheet1** serves as a structured representation of financial activities essential for Financial Planning & Analysis (FP&A). It consolidates financial data across various periods and subsidiaries, ensuring that all financial transactions are accurately tracked and reported. This table is critical for validating accounting integrity, as it ensures that total debits equal total credits for a specific period and entity.\n\n**Size/Scope:**\n- Total rows: 348\n- Summary nodes: Not applicable (the structure is flat with no hierarchical relationships)\n- Leaf accounts/members: 132 distinct account numbers\n\n## Column definitions\n\n- **account_number**: Represents the unique identifier for financial accounts, crucial for tracking and reporting financial transactions.\n- **subsidiary**: Indicates the name of the subsidiary associated with financial transactions, facilitating consolidation of financial data.\n- **subsidiary_id**: Serves as the unique identifier for subsidiaries, linking financial data to specific subsidiaries.\n- **_3_months_ago**: Contains financial data from three months prior, used for historical financial analysis.\n- **formula_numeric**: Represents calculated financial values for reporting and analysis.\n- **_2_months_ago**: Contains financial data from two months prior, aiding in historical comparison.\n- **formula_numeric_1**: Another calculated financial value used for performance measurement and variance analysis.\n- **last_month**: Represents financial data for the previous month, used for comparative analysis.\n- **formula_numeric_2**: A further calculated financial value for performance measurement and variance analysis.\n- **event**: Describes specific financial events, essential for tracking and reporting financial activities.\n- **event_id**: Unique identifier for events related to financial activities, used for tracking specific events.\n- **opponent**: Identifies the counterpart involved in financial activities, though this column contains no data.\n- **day**: Represents the specific day associated with financial activities, with limited unique values.\n- **activity**: Describes financial activities, aiding in categorization and analysis of transactions.\n- **activity_id**: Unique identifier for activities related to financial transactions, used for tracking specific activities.\n- **department**: Indicates the organizational unit responsible for financial activities, categorizing financial data by department.\n\n## Missing/unpopulated fields & gap analysis\n\n**Unpopulated fields present in the file:**\n- **opponent**: Contains no data.\n- **day**: Contains no data for some entries, though it has 7 unique values.\n\n**Expected industry-standard fields missing entirely:**\n- While the table includes essential financial metrics, it lacks fields that might typically capture additional contextual information, such as transaction descriptions or detailed timestamps. The absence of these fields could impact the granularity of financial reporting and analysis.\n\n## The structure it defines\n\nThe structure of the **Trial Balance Sheet1** is flat, with no hierarchical relationships. All entries are at the same depth level, allowing for straightforward aggregation without the risk of violating hierarchical relationships.\n\n- **Key groupings**:\n  - **Account Numbers**: 132 distinct values, with significant concentrations in certain accounts (e.g., \"1100.0\" appears 28 times).\n  - **Subsidiaries**: 6 distinct values, with \"Subsidiary 3\" being the most frequent (157 occurrences).\n  - **Events**: Predominantly \"Event 1,\" recorded 240 times, indicating a focus on this particular financial event.\n  - **Activities**: \"Activity 1\" occurs 276 times, suggesting a strong emphasis on this activity.\n\n## How it connects to related data/other tables\n\n- **Primary key relationships (PKRT)**: \n  - The primary keys are **account_number** and **event_id**, which are referenced by multiple tables, including the **Chart of Accounts Hierarchy Format** and **General Ledger Sheet1**.\n  \n- **Foreign key relationships (FKRT)**: \n  - The table references the **General Ledger** and **Chart of Accounts**, ensuring that financial activities are accurately categorized and reported.\n\n## Data patterns briefing\n\n- **Code/ID ranges**: The account numbers exhibit a range of values, with notable concentrations in specific accounts (e.g., \"1100.0\" and \"2000.0\").\n- **Naming conventions**: The subsidiary names and activities follow a consistent naming pattern, aiding in categorization.\n- **Value distributions**: A significant number of entries in the **formula_numeric** columns show zero values (49% for **formula_numeric**), indicating potential inactivity or unrecorded transactions.\n- **Grouping patterns**: Records cluster around specific accounts, events, and activities, reflecting the financial structure of the organization.\n\n## Quality of the data\n\n- **Completeness**: All fields are populated except for **opponent** and **day**, which contain no data.\n- **Consistency**: The dataset shows consistent naming patterns and adherence to expected formats, although the presence of zero values in financial metrics may require further investigation.\n- **Gaps**: The absence of detailed transaction descriptions and timestamps could limit the depth of analysis.\n- **Integrity issues**: No duplicates or invalid references were identified, indicating a high level of data integrity.\n\nOverall, the **Trial Balance Sheet1** presents a comprehensive view of financial activities, with clear patterns and structures that support FP&A activities. The dataset's integrity and utility for financial analysis are high, given the comprehensive nature of the recorded data and the clear patterns that emerge from the analysis."},
		{"id":"95791778ceeb2f3c","x":7520,"y":-1480,"width":860,"height":960,"type":"text","text":"The data represented in the \"Chart of Accounts Hierarchy Format\" table is a structured representation of financial account classifications essential for the Financial Planning & Analysis (FP&A) domain. This table plays a critical role in defining the enterprise's financial structure, categorizing all financial activities into consistent, reportable categories. It serves as a master data reference that supports account classification, relationship establishment, and financial reporting, ensuring that every account is unique, correctly typed, and aligned with reporting hierarchies.\n\nThe table contains a total of 455 rows and 8 columns, with a significant portion of these accounts being leaf nodes—approximately 70%—indicating that they are terminal in the hierarchy and primarily used for recording financial transactions. The hierarchy is characterized by a self-referencing structure, where the root node is the \"Chart of Accounts,\" branching out into various account categories such as \"Bank,\" \"Other Current Liability,\" and \"Stadium & Facilities.\" There are 65 distinct parent categories identified, contributing to the structural integrity of the financial reporting framework.\n\nEach column in the table serves a specific purpose. The \"dim\" column categorizes account types, while \"member_name\" identifies the names of financial account members. The \"member_alias\" provides alternative identifiers for cross-referencing, and \"parent_name\" establishes hierarchical relationships among accounts. The \"operator\" column indicates the mathematical operations associated with account calculations, predominantly showing a tendency towards addition, which aligns with the nature of financial accounts. The \"cmd\" column, while present, does not contain any values, indicating a potential area for improvement in capturing operational commands. The \"member_id\" serves as the unique identifier for each account, although it appears to be a constant value across all entries, which may require further refinement for better traceability. The \"external_id\" is also present but lacks specific values, suggesting it may be used for linking to external systems in future implementations.\n\nFrom a data quality perspective, the table exhibits high completeness, with no null values across all columns. However, there are 76 instances of the \"member_alias\" being \"nan,\" which indicates potential gaps in naming conventions that could be addressed for better clarity. The dataset shows a strong reliance on a few key categories for financial reporting, with \"Bank\" appearing 42 times, \"Other Current Liability\" 32 times, and \"Stadium & Facilities\" 28 times, representing significant portions of the total.\n\nIn terms of relationships, the \"member_id\" serves as a primary key that connects to various other tables, including the Trial Balance and General Ledger, establishing a one-to-many relationship where each account can be referenced multiple times across different financial reports. The foreign key relationships indicate that the General Ledger and Trial Balance must reference valid accounts defined in this table for accurate financial reporting.\n\nOverall, the \"Chart of Accounts Hierarchy Format\" table is a well-structured and essential component of the financial data ecosystem, providing a robust framework for financial reporting and analysis. Its clear hierarchical relationships, straightforward naming conventions, and strong tendency towards additive behavior in financial calculations underscore its importance in supporting FP&A processes. Analysts can effectively query this table to extract account classifications, establish relationships, and ensure accurate financial reporting, while also addressing the noted gaps for continuous improvement in data quality and clarity."},
		{"id":"1fc6e1458c6dbe60","x":2600,"y":-4100,"width":513,"height":709,"type":"text","text":"## What this table is\n\nThe **Chart of Accounts Hierarchy Format** serves as a master reference table that defines the structure and classification of financial accounts within the Financial Planning & Analysis (FP&A) domain. This table is essential for organizing financial data into a coherent hierarchy, ensuring that all financial activities are categorized consistently for reporting and analysis.\n\n**Size/Scope:**\n- Total rows: **455**\n- Summary nodes: **65** (distinct parent categories)\n- Leaf accounts/members: **318** (approximately 70% of total nodes)\n\n## Column definitions\n\n- **dim**: Represents the dimension type for financial accounts, categorizing account types within the Chart of Accounts.\n- **member_name**: Contains the names of financial account members, used for identifying account categories; it includes unique identifiers for each account.\n- **member_alias**: Provides alternative identifiers for financial account members, facilitating cross-referencing of account names.\n- **parent_name**: Indicates the hierarchical parent names for financial accounts, establishing relationships within the account structure.\n- **operator**: Specifies the mathematical operators (e.g., +, -) used for account calculations, defining how accounts relate to one another.\n- **cmd**: Represents commands associated with the Chart of Accounts, defining operations within financial data structures.\n- **member_id**: Serves as the unique identifier for each member in the Chart of Accounts, ensuring uniqueness and traceability.\n- **external_id**: Represents external reference identifiers for members, linking to external financial systems.\n\n## Missing/unpopulated fields & gap analysis\n\n**Unpopulated fields present in the file:**\n- **cmd**: Fully populated but contains only \"nan\" values, indicating a lack of meaningful command data.\n- **member_id**: Fully populated but contains only \"nan\" values, suggesting a need for a more effective identification system.\n\n**Expected industry-standard fields missing entirely:**\n- No critical fields are missing that would significantly impact analytical capabilities or operational workflows. However, enhancing the naming conventions and ensuring unique identifiers could improve clarity and usability.\n\n## The structure it defines\n\nThe table exhibits a **hierarchical structure** with clear parent-child relationships:\n\n- **Top-level nodes**: The root element is the \"Chart of Accounts.\"\n- **Major branches**:\n  - **Balance Sheet** (leaf count: 5; codes: 1001-1005)\n  - **Assets** (leaf count: 4; codes: 1001-1004)\n  - **Liabilities** (leaf count: 3; codes: 2001-2003)\n- **Operator logic**: The predominant use of the addition operator (+) indicates that most accounts are additive, aligning with typical financial reporting practices.\n\n## How it connects to related data/other tables\n\n- **Primary key relationships (PKRT)**: The **member_id** serves as the primary key, linking to various tables such as the **Trial Balance** and **General Ledger**, establishing a one-to-many relationship where each account can be referenced multiple times across these tables.\n- **Foreign key relationships (FKRT)**: The **account_number** serves as a foreign key, linking to the **General Ledger** and **Trial Balance**, ensuring that all financial transactions reference valid accounts defined in this hierarchy.\n\n## Data patterns briefing\n\n- **Code/ID ranges**: The dataset does not explicitly categorize accounts into traditional ranges, but specific identifiers like \"1001\" to \"1005\" are associated with \"US Bank,\" indicating a systematic approach to account numbering.\n- **Naming conventions**: The naming convention is straightforward, with no complex modifiers or suffixes present, although there are instances of \"nan\" in the **member_alias** column that could be addressed for clarity.\n- **Operator/flag usage**: The dataset shows a predominance of the addition operator (+) with 452 instances compared to only 3 instances of subtraction (-), reinforcing the additive nature of financial accounts.\n- **Value distributions**: The concentration of records in specific parent categories, such as \"Bank\" appearing 42 times, suggests a strong reliance on a few key categories for financial reporting.\n\n## Quality of the data\n\n- **Completeness**: All fields are fully populated, but the presence of \"nan\" values in **cmd** and **member_id** indicates a lack of meaningful data in these columns.\n- **Consistency**: The dataset adheres to a consistent naming pattern, although the presence of \"nan\" in **member_alias** suggests potential inconsistencies that could be improved.\n- **Gaps**: The absence of meaningful data in **cmd** and **member_id** represents a gap in the identification system that could hinder traceability.\n- **Integrity issues**: No duplicates or invalid references were identified, indicating a high level of data integrity overall. \n\nIn conclusion, the **Chart of Accounts Hierarchy Format** is a well-structured table that plays a crucial role in financial reporting and analysis, with clear hierarchical relationships and a strong focus on additive behavior in financial calculations. However, addressing the gaps in naming conventions and identifiers could further enhance its usability and clarity."}
	],
