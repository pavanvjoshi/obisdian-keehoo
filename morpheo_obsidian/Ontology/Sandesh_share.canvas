		{"id":"d732ffa769e83087","type":"text","text":"concept binding - concepts to Actual tables, Fields","x":-520,"y":1020,"width":250,"height":60,"color":"1"},
		{"id":"9392983bec72b4bf","type":"text","text":"User asks a question: what is the net income for the month? ","x":40,"y":1660,"width":361,"height":74},
		{"id":"3bee1ab0e6f7922c","type":"text","text":"User asks a question: what is the net income for the month? ","x":-351,"y":1500,"width":361,"height":74},
		{"id":"634a3c6cdba9d128","type":"text","text":"Net income= Revenue - Expenses","x":-620,"y":1600,"width":250,"height":60},
		{"id":"23f6d2360cb7a649","type":"text","text":"Revenue - Calculate - These are the mappings","x":-476,"y":1734,"width":250,"height":60},
		{"id":"f8f6467d17bd5b51","type":"text","text":"Expense - Calculate - These are the mappings","x":-476,"y":1860,"width":250,"height":60},
		{"id":"1b2496a843dc3223","type":"text","text":"Netincome - Calculate - These are the mappings","x":-476,"y":2000,"width":250,"height":60},
		{"id":"31ec94ff1e495875","type":"text","text":"Netincome by Period - Final answer","x":-476,"y":2120,"width":250,"height":60},
