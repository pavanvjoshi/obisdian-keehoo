	"nodes":[
		{"id":"3f12d81f2dbae102","type":"group","x":8000,"y":-4000,"width":6906,"height":2860,"label":"DEV CIC PLAN "},
		{"id":"eb8899f5ef4807eb","type":"group","x":-5600,"y":-3870,"width":3708,"height":2599,"label":"CIC Dev Plans and Blockers"},
		{"id":"e33bb9f8e7cd384a","type":"group","x":0,"y":-3090,"width":2396,"height":1040,"label":"Backup of insert event_type"},
		{"id":"0d6ab481c6f29669","type":"group","x":3840,"y":-3160,"width":1920,"height":1180,"label":"Prompts"},
