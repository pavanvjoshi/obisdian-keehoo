		{
			"id":"0f42c39b7d0d0e28",
			"type":"text",
			"text":"```mermaid\nflowchart TD\n    START([Start: Contact Intake]) --> ENRICH[Tool: MCP Enrich Contact]\n    ENRICH --> SCORE[Agent: AI Score 0-100]\n    SCORE --> GATE{\"Condition: score >= campaign.threshold?\"}\n\n    GATE -- No --> END_NQ([End: Not Qualified])\n    GATE -- Yes --> DRAFT[Agent: AI Draft Intro Email]\n    DRAFT --> SEND1[Tool: MCP Send Email]\n    SEND1 --> DELAY1{{\"Delay: fixed wait 3 days\"}}\n    DELAY1 --> CHECK1[/Human Task: check inbox, decide Replied or No Reply — paste reply text + compose response if Replied/]\n\n    CHECK1 -- Replied --> SEND_R1[Tool: MCP Send Reply]\n    SEND_R1 --> END_OK([End: Replied and Handled])\n\n    CHECK1 -- No Reply --> FU1[/Human Task: provide Follow-up 1 content/]\n    FU1 --> SEND2[Tool: MCP Send Follow-up 1]\n    SEND2 --> DELAY2{{\"Delay: fixed wait 3 days\"}}\n    DELAY2 --> CHECK2[/Human Task: check inbox, decide Replied or No Reply/]\n\n    CHECK2 -- Replied --> SEND_R2[Tool: MCP Send Reply]\n    SEND_R2 --> END_OK\n\n    CHECK2 -- No Reply --> FU2[/Human Task: provide Follow-up 2 content/]\n    FU2 --> SEND3[Tool: MCP Send Follow-up 2]\n    SEND3 --> DELAY3{{\"Delay: fixed wait 3 days\"}}\n    DELAY3 --> CHECK3[/Human Task: check inbox, decide Replied or No Reply/]\n\n    CHECK3 -- Replied --> SEND_R3[Tool: MCP Send Reply]\n    SEND_R3 --> END_OK\n\n    CHECK3 -- No Reply --> END_NR([End: No Response])\n\n    classDef today fill:#ddffdd,stroke:#009900,stroke-width:2px;\n    class DELAY1,DELAY2,DELAY3,CHECK1,CHECK2,CHECK3 today;\n```",
			"styleAttributes":{},
			"x":400,
			"y":6880,
			"width":1280,
			"height":2640
		},
