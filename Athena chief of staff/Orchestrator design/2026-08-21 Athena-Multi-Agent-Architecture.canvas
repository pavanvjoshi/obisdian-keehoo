		{"id":"synth","type":"text","text":"Synthesizer Node\n\nConsumes:\n- completed task outputs\n- failed/partial task states\n- tool evidence / provenance\n- original user intent\n\nProduces one coherent Athena response.","x":3650,"y":18,"width":430,"height":295}
