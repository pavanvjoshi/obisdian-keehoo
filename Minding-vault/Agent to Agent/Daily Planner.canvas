	"nodes":[
		{"id":"126cdbdc640bb325","x":649,"y":-3020,"width":971,"height":1120,"type":"text","text":"```mermaid\n%%{init: {\"theme\": \"base\", \"themeVariables\": {\"primaryColor\": \"#1e293b\", \"primaryTextColor\": \"#f8fafc\", \"primaryBorderColor\": \"#38bdf8\", \"lineColor\": \"#64748b\", \"background\": \"#0f172a\", \"mainBkg\": \"#1e293b\", \"fontFamily\": \"ui-sans-serif, sans-serif\", \"fontSize\": \"16px\"}}}%%\n\nflowchart TD\n\n    USER([\"👤 You\\nAsk anything in plain English\"])\n\n    CLI[\"🖥️ CLI\\nRich interactive terminal\"]\n\n    BRAIN[\"🧠 Orchestrator\\nUnderstands your request\\nDecides what to do & in what order\"]\n\n    PROTO([\"🔗 A2A Protocol\\nHTTP · JSON-RPC 2.0\\nStandardised agent communication\"])\n\n    subgraph AGENTS[\"  Specialist Sub-Agents  \"]\n        direction LR\n        A1[\"📅 Calendar Agent\\nRead events\\nReschedule timings\\nSpot conflicts\"]\n        A2[\"✅ Tasks Agent\\nRead to-dos\\nChange priorities\"]\n        A3[\"⚡ Context Agent\\nScan emails\\nFlag urgent items\"]\n    end\n\n    DATA[(\"💾 Your Data\\ncalendar · tasks · emails\")]\n\n    ANSWER[\"✨ Final Answer\\nClean daily agenda\\nConflicts resolved\\nPriorities set\"]\n\n    USER -->|\"Plan my day / Move E001 to 3pm\\nSet T002 to high priority\"| CLI\n    CLI --> BRAIN\n    BRAIN -->|\"Delegates via\"| PROTO\n    PROTO --> AGENTS\n    AGENTS <-->|\"Read & Write\"| DATA\n    AGENTS -->|\"Structured results\"| BRAIN\n    BRAIN --> ANSWER\n    ANSWER --> CLI\n    CLI -->|\"Rendered response\"| USER\n\n    classDef user     fill:#0ea5e9,stroke:#7dd3fc,color:#fff,font-weight:bold,font-size:15px\n    classDef cli      fill:#1d4ed8,stroke:#60a5fa,color:#fff,font-size:14px\n    classDef brain    fill:#7c3aed,stroke:#a78bfa,color:#fff,font-weight:bold,font-size:14px\n    classDef proto    fill:#0f766e,stroke:#2dd4bf,color:#fff,font-size:13px\n    classDef agent    fill:#b45309,stroke:#fbbf24,color:#fff,font-size:13px\n    classDef data     fill:#1e1b4b,stroke:#818cf8,color:#e0e7ff,font-size:14px\n    classDef answer   fill:#15803d,stroke:#4ade80,color:#fff,font-weight:bold,font-size:14px\n\n    class USER user\n    class CLI cli\n    class BRAIN brain\n    class PROTO proto\n    class A1,A2,A3 agent\n    class DATA data\n    class ANSWER answer\n```"}
